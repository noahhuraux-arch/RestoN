# NGINX Stage
FROM nginx:1.27-alpine AS nginx-prod
LABEL maintainer="Resto-N Team"
LABEL description="Production NGINX server for Resto-N"
COPY nginx.conf /etc/nginx/conf.d/default.conf
RUN mkdir -p /var/www/html/public && \
    chown -R nginx:nginx /var/www/html && \
    chmod -R 755 /var/www/html
WORKDIR /var/www/html/public
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget --quiet --tries=1 --spider http://localhost/ || exit 1

EXPOSE 80

# PHP Base Stage
FROM php:8.2-fpm-alpine AS php-base
LABEL maintainer="Resto-N Team"
RUN apk add --no-cache \
    git \
    unzip \
    icu-libs \
    icu-dev \
    libzip \
    libzip-dev \
    libpng \
    libpng-dev \
    oniguruma \
    oniguruma-dev \
    libxml2 \
    libxml2-dev \
    curl \
    ca-certificates
RUN docker-php-ext-install -j$(nproc) \
    intl \
    pdo \
    pdo_mysql \
    zip \
    gd \
    xml \
    opcache

RUN docker-php-ext-enable opcache && \
    echo "opcache.enable=1" >> /usr/local/etc/php/conf.d/docker-php-ext-opcache.ini && \
    echo "opcache.enable_cli=0" >> /usr/local/etc/php/conf.d/docker-php-ext-opcache.ini && \
    echo "opcache.memory_consumption=256" >> /usr/local/etc/php/conf.d/docker-php-ext-opcache.ini && \
    echo "opcache.interned_strings_buffer=16" >> /usr/local/etc/php/conf.d/docker-php-ext-opcache.ini && \
    echo "opcache.max_accelerated_files=20000" >> /usr/local/etc/php/conf.d/docker-php-ext-opcache.ini && \
    echo "opcache.validate_timestamps=0" >> /usr/local/etc/php/conf.d/docker-php-ext-opcache.ini && \
    echo "opcache.revalidate_freq=0" >> /usr/local/etc/php/conf.d/docker-php-ext-opcache.ini
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer
WORKDIR /var/www/html
RUN echo "display_errors=0" >> /usr/local/etc/php/conf.d/docker-php.ini && \
    echo "log_errors=1" >> /usr/local/etc/php/conf.d/docker-php.ini && \
    echo "error_log=/var/log/php-errors.log" >> /usr/local/etc/php/conf.d/docker-php.ini
# PHP Production
FROM php-base AS php-prod
LABEL maintainer="Resto-N Team"
LABEL description="Production PHP-FPM server for Resto-N"
ENV APP_ENV=prod \
    APP_DEBUG=0
COPY --chown=www-data:www-data . /var/www/html
RUN mkdir -p /var/www/html/var/cache /var/www/html/var/log && \
    chown -R www-data:www-data /var/www/html && \
    chmod -R 755 /var/www/html/var && \
    chmod -R 755 /var/www/html/public
RUN export COMPOSER_ALLOW_SUPERUSER=1 && \
    composer install \
    --no-dev \
    --optimize-autoloader \
    --no-interaction \
    --no-progress \
    --prefer-dist
RUN php bin/console cache:clear --env=prod && \
    php bin/console cache:warmup --env=prod && \
    php bin/console asset-map:compile --env=prod
RUN rm -rf .git .gitignore .gitattributes && \
    rm -rf vendor/*/tests vendor/*/docs vendor/*/examples
RUN echo "pm.max_children=50" >> /usr/local/etc/php-fpm.d/zz-docker.conf && \
    echo "pm.start_servers=10" >> /usr/local/etc/php-fpm.d/zz-docker.conf && \
    echo "pm.min_spare_servers=5" >> /usr/local/etc/php-fpm.d/zz-docker.conf && \
    echo "pm.max_spare_servers=35" >> /usr/local/etc/php-fpm.d/zz-docker.conf && \
    echo "clear_env=no" >> /usr/local/etc/php-fpm.d/zz-docker.conf
RUN chown -R www-data:www-data /var/www/html/var && \
    chmod -R 755 /var/www/html/var
USER www-data
HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 \
    CMD php bin/console about || exit 1
EXPOSE 9000

# Final Stage
FROM php-prod AS production
LABEL maintainer="Resto-N Team"
LABEL description="Production runtime for Resto-N"
USER root
COPY entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["php-fpm"]

