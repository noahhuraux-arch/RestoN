{% extends 'base.html.twig' %}

{% block title %}Modification d'une boisson'{% endblock %}

{% block body %}
<div class="container py-5">
    <h1 class="mb-4">Modification de la boisson {{ boisson.libProduit }}</h1>

    <div class="card shadow-sm">
        <div class="card-body">

            {{ form_start(form) }}

            {{ form_row(form.libProduit) }}
            {{ form_row(form.descriptionProduit) }}

            <div class="row">
                <div class="col-md-4">
                    {{ form_row(form.prixProduit) }}
                </div>
            </div>

            {{ form_row(form.visible) }}
            {{ form_row(form.alcoolise) }}

            <div class="mt-4 d-grid gap-2 d-md-flex justify-content-md-end">
                <button type="submit" class="btn btn-primary px-4">
                    Modifier
                </button>
            </div>

            {{ form_end(form) }}

        </div>
    </div>
</div>
{% endblock %}
