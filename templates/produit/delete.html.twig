{% extends 'base.html.twig' %}

{% block title %}Supprimer le produit - {{ produit.libProduit }} - {{ produit.restaurant.libRestau }}{% endblock %}

{% block body %}
    <div class="container py-5">
        <div class="alert alert-danger text-center">
            <h1 class="h3"> Attention !</h1>
            <p class="lead">
                Êtes-vous sûr de vouloir supprimer définitivement ce produit
                <strong>"{{ produit.libProduit }}"</strong> ?
            </p>
            <p>Cette action est irréversible.</p>
        </div>

        <div class="d-flex justify-content-center mt-5">
            {{ form_start(form, {attr: {class: 'd-flex gap-3 align-items-center'}}) }}

            {{ form_widget(form.delete, {
                label: 'Supprimer',
                attr: {class: 'btn btn-danger'},
            }) }}

            {{ form_widget(form.cancel, {
                label: 'Annuler',
                attr: {class: 'btn btn-secondary'},
            }) }}

            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
