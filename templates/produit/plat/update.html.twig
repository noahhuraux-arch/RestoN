{% extends 'base.html.twig' %}

{% block title %}Modification du plat {{ plat.libProduit }}{% endblock %}

{% block body %}
    <div class="container py-5">
        <h1 class="mb-4">Modification du plat {{ plat.libProduit }}</h1>

        <div class="card shadow-sm">
            <div class="card-body">

                {{ form_start(form) }}

                {{ form_row(form.libProduit) }}
                {{ form_row(form.descriptionProduit) }}

                <div class="row">
                    <div class="col-md-4">
                        {{ form_row(form.prixProduit) }}
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-3">
                        {{ form_row(form.visible) }}
                    </div>
                    <div class="col-md-3">
                        {{ form_row(form.vegetarien) }}
                    </div>
                </div>

                <span>Allergènes</span>
                <div class=" mb-2 mt-2 p-3 border rounded bg-light d-flex flex-wrap gap-2">
                    {% for allergene in form.allergenes %}
                        <div class="form-check form-check-inline m-0">
                            {{ form_widget(allergene) }}
                            {{ form_label(allergene) }}
                        </div>
                    {% endfor %}
                </div>

                {{ form_row(form.typePlat) }}

                <div class="mt-4 d-grid gap-2 d-md-flex justify-content-between">
                    <a href="{{ path('app_produit_details', {id: plat.id}) }}" class="btn btn-light border rounded-3 px-4 fs-6">
                        ← Retour
                    </a>

                    <button type="submit" class="btn btn-primary px-4">
                        Modifier
                    </button>
                </div>

                {{ form_end(form) }}

            </div>
        </div>
    </div>
{% endblock %}
