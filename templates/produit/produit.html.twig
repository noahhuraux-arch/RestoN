{% extends 'base.html.twig' %}

{% block title %}{{ produit.libProduit }}{% endblock %}

{% block body %}
    <div class="container mt-5" style="max-width: 800px;">
        <div class="card shadow-sm border-0 rounded-4">
            <div class="card-body p-4">

                <div class="d-flex justify-content-between align-items-center mb-1">
                    <h1 class="fw-bold m-0" >
                        {{ produit.libProduit }}
                    </h1>
                    <span class="fw-bold fs-2">
                        {{ produit.prixProduit }} €
                    </span>
                </div>

                <p class="text-muted mb-4">
                    {% if produit.typePlat is defined %}
                        Plat - {{ produit.typePlat.lib }}
                    {% elseif produit.alcoolise is defined %}
                        Boisson
                    {% endif %}
                </p>

                <hr>

                {% if produit.descriptionProduit %}
                    <p class="mt-3 fs-5">
                        {{ produit.descriptionProduit }}
                    </p>
                {% else %}
                    <p class="text-muted fst-italic">
                        Aucune description disponible.
                    </p>
                {% endif %}

                <hr>

                <div class="d-flex justify-content-start align-items-center mt-4">
                <span class="badge {% if produit.visible %}bg-success{% else %}bg-danger{% endif %} px-3 py-2">
                    {{ produit.visible ? 'Visible sur la carte' : 'Non visible' }}
                </span>
                </div>

                <hr>

                <p class="text-muted mt-3 fs-5">
                    Restaurant :
                    <strong>{{ produit.idRestau.libRestau ?? 'Non renseigné' }}</strong>
                </p>

                <div class="d-flex justify-content-between mt-4">
                    <a href="{{ path('app_produit_proprio', { idRestau: produit.idRestau.id , idBoisson: produit.id}) }}" class="btn btn-light border rounded-3 px-4 fs-6">
                        ← Retour à la carte
                    </a>

                    {% if produit.alcoolise is defined %}
                        <a href="{{ path('app_produit_boisson_update', { idRestau: produit.idRestau.id, idBoisson: produit.id}) }}" class="btn btn-outline-primary rounded-3 px-4 fs-6 fw-bold">
                            Modifier
                        </a>
                    {% elseif produit.typePlat is defined %}
                        <a href="{{ path('app_produit_plat_update', { idRestau: produit.idRestau.id , idPlat: produit.id}) }}" class="btn btn-outline-primary rounded-3 px-4 fs-6 fw-bold">
                            Modifier
                        </a>
                    {% endif %}
                </div>

            </div>

            </div>
        </div>
    </div>
{% endblock %}
