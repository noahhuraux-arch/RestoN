{% extends 'base.html.twig' %}

{% block title %}{{ produit.libProduit }}{% endblock %}

{% block body %}
    <div class="container mt-5" style="max-width: 800px;">
        <div class="card shadow-sm border-0 rounded-4">
            <div class="card-body p-4">

                <div class="d-flex justify-content-between align-items-center mb-1">
                    <h1 class="fw-bold m-0" >
                        {{ produit.libProduit }}
                    </h1>
                    <span class="fw-bold fs-2">
                        {{ produit.prixProduit }} €
                    </span>
                </div>

                <p class="text-muted mb-4">
                    {% if produit.typePlat is defined %}
                        Plat - {{ produit.typePlat.lib }}
                    {% elseif produit.alcoolise is defined %}
                        Boisson
                    {% endif %}
                </p>

                <hr>

                {% if produit.descriptionProduit %}
                    <p class="mt-3 fs-5">
                        {{ produit.descriptionProduit }}
                    </p>
                {% else %}
                    <p class="text-muted fst-italic">
                        Aucune description disponible.
                    </p>
                {% endif %}

                {% if plats %}
                    <hr>
                    <h5>Composition du menu :</h5>
                    {% if entrees %}
                        <ul class="list-unstyled">
                            <h6>Entrées :</h6>
                            {% for entree in entrees %}
                                <div>
                                    <a href="{{ path('app_produit_details', {id: entree.id}) }}" class="text-decoration-none text-body">
                                        {{ entree.libProduit }}
                                    </a>
                                </div>
                            {% endfor %}
                        </ul>
                    {% endif %}

                    {% if plats %}
                        <ul class="list-unstyled">
                            <h6>Plats :</h6>
                            {% for pl in plats %}
                                <div>
                                    <a href="{{ path('app_produit_details', {id: pl.id}) }}" class="text-decoration-none text-body">
                                        {{ pl.libProduit }}
                                    </a>
                                </div>
                            {% endfor %}
                        </ul>
                    {% endif %}

                    {% if desserts %}
                        <ul class="list-unstyled">
                            <h6>Desserts :</h6>
                            {% for dessert in desserts %}
                                <div>
                                    <a href="{{ path('app_produit_details', {id: dessert.id}) }}" class="text-decoration-none text-body">
                                        {{ dessert.libProduit }}
                                    </a>
                                </div>
                            {% endfor %}
                        </ul>
                    {% endif %}

                {% endif %}

                {% if is_granted('ROLE_PROPRIETAIRE') and app.user == produit.idRestau.proprietaire%}
                    <hr class="mt-4 mb-4">

                    <div class="d-flex justify-content-start align-items-center">
                        {% if is_granted('ROLE_PROPRIETAIRE') and app.user == produit.idRestau.proprietaire%}
                            {% if produit.visible %}
                                <span class="badge bg-success px-3 py-2 me-3">Visible sur la carte</span>
                            {% else %}
                                <span class="badge bg-danger px-3 py-2 me-3">Non visible</span>
                            {% endif %}
                        {% endif %}

                        {% if produit.alcoolise is defined %}
                            {% if produit.alcoolise %}
                                <span class="badge bg-danger px-3 py-2">Alcoolisé</span>
                            {% else %}
                                <span class="badge bg-success px-3 py-2">Sans alcool</span>
                            {% endif %}
                        {% endif %}
                    </div>
                {% endif %}

                <hr class="mt-4 mb-4">

                <p class="text-muted fs-5">
                    Restaurant :
                    <strong>{{ produit.idRestau.libRestau ?? 'Non renseigné' }}</strong>
                </p>

                <div class="mt-4 d-flex justify-content-between align-items-center">
                    <a href="{{ path('app_produit_proprietaire', {idRestau: produit.idRestau.id, idBoisson: produit.id}) }}" class="btn btn-light border rounded-3 px-4 fs-6">
                        ← Retour à la carte
                    </a>

                    {% if is_granted('ROLE_PROPRIETAIRE') and app.user == produit.idRestau.proprietaire%}

                        <div class="d-flex gap-2">
                            {% if produit.alcoolise is defined %}
                                <a href="{{ path('app_produit_boisson_update', {idRestau: produit.idRestau.id, idBoisson: produit.id}) }}" class="btn btn-outline-primary rounded-3 px-4 fs-6 fw-bold">
                                    Modifier
                                </a>
                            {% elseif produit.typePlat is defined %}
                                <a href="{{ path('app_produit_plat_update', {idRestau: produit.idRestau.id, idPlat: produit.id}) }}" class="btn btn-outline-primary rounded-3 px-4 fs-6 fw-bold">
                                    Modifier
                                </a>
                            {% elseif plats %}
                                <a href="{{ path('app_produit_menu_update', {idRestau: produit.idRestau.id, idMenu: produit.id}) }}" class="btn btn-outline-primary rounded-3 px-4 fs-6 fw-bold">
                                    Modifier
                                </a>
                            {% endif %}

                            <a href="{{ path('app_produit_delete', {id: produit.id}) }}" class="btn btn-danger border rounded-3 px-4 fs-6">
                                Supprimer
                            </a>
                        </div>
                    {% endif  %}
                </div>

            </div>

            </div>
        </div>
{% endblock %}
