
{% extends 'base.html.twig' %}

{% block title %} Création d'un menu {% endblock %}

{% block body %}

    <div class="container py-5">
        <h1 class="mb-4">Créer un menu pour {{ restaurant.libRestau }}</h1>

        <div class="card shadow-sm">
            <div class="card-body">

                {{ form_start(form) }}

                {{ form_row(form.libProduit) }}
                {{ form_row(form.descriptionProduit) }}

                <div class="row">
                    <div class="col-md-4">
                        {{ form_row(form.prixProduit) }}
                    </div>
                </div>

                {{ form_row(form.visible) }}

                <h2 class="h5 mt-4 mb-3">Composition du Menu</h2>
                <div class="row">
                    <div class="col-md-6">
                        {{ form_row(form.idPlat) }}
                    </div>
                </div>

                <div class="mt-4 d-grid gap-2 d-md-flex justify-content-between">
                    <a href="{{ path('app_produit_proprietaire', { idRestau: restaurant.id }) }}" class="btn btn-outline-secondary rounded-3 px-4 fs-6">
                        ← Retour à la carte
                    </a>

                    <button type="submit" class="btn btn-primary px-4 rounded-3">
                        Créer
                    </button>
                </div>

                {{ form_end(form) }}

            </div>
        </div>
    </div>

{% endblock %}
