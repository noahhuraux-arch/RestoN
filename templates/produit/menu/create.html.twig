{% extends 'base.html.twig' %}

{% block title %}Création d'un menu{% endblock %}

{% block body %}
    {% set title_type = 'menu' %}

    <div class="container py-5">
        <div class="card shadow-sm">
            <div class="card-body">
                {{ form_start(form) }}

                <h1 class="mb-4">Créer un {{ title_type }}</h1>

                {% include 'produit/_create.html.twig' %}

                <div class="mt-4 d-grid gap-2 d-md-flex justify-content-between">
                    <a href="{{ path('app_produit_proprietaire', {idRestau: restaurant.id}) }}" class="btn btn-light border rounded-3 px-4 fs-6">
                        ← Retour à la carte
                    </a>
                    <button type="submit" class="btn btn-primary px-4">Créer</button>
                </div>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
{% endblock %}
