{% extends 'base.html.twig' %}

{% block title %}Menu{% endblock %}

{% block body %}
    <h1>Menu</h1>

    <h2>Boissons</h2>
    <ul class="boissons">
        {% for boisson in boissons %}
            <li>
                <span class="prodName">{{ boisson.libProduit }}</span>
                <span class="prodPrice">{{ boisson.prixProduit}}</span>
                <span class="prodName">{{ boisson.descriptionProduit}}</span>
            </li>
        {% endfor %}
    </ul>

{% endblock %}
