{% extends 'base.html.twig' %}

{% block title %}Accueil - {{ restaurant.libRestau }}{% endblock %}

{% block favicon %}
    {% if restaurant.logo %}
        <link rel="icon" href="{{ asset('images/logos/' ~ restaurant.logo) }}">
    {% endif %}
{% endblock %}

{% block body %}
    <div class="container">
        <div class="home-section" style="{% if restaurant.banniere %}background-image: url('{{ asset('images/thumbnails/' ~ restaurant.banniere) }}');{% endif %} background-color: #343a40;">
            <div class="home-overlay"></div>
            <div class="home-content">
                <h1 class="display-3 fw-bold">{{ restaurant.libRestau }}</h1>
                <p class="lead mb-4">Une expérience culinaire authentique et moderne.</p>
                <div class="d-grid gap-2 d-sm-flex justify-content-sm-center">
                    <a href="{{ path('app_produit', {idRestau: restaurant.id}) }}" class="btn btn-warning btn-lg px-4 gap-3">Voir la Carte</a>
                    <a href="{{ path('app_reservation_create', {id: restaurant.id}) }}" class="btn btn-light btn-lg px-4">Réserver une table</a>
                </div>
            </div>
        </div>

        <div class="row mb-5">
            <div class="col-md-4 mb-4">
                <div class="info-card">
                    <i class="fa fa-clock fa-3x mb-3"></i>
                    <h4>Horaires d'aujourd'hui</h4>
                    <p class="mb-0 text-uppercase">{{ nom_jour_actuel }}</p>
                    <p class="fw-bold">{{ texte_horaire_actuel }}</p>
                </div>
            </div>

            <div class="col-md-4 mb-4">
                <div class="info-card">
                    <i class="fa fa-map-marker-alt fa-3x mb-3"></i>
                    <h4>Nous trouver</h4>
                    <a href="https://www.google.com/maps/search/?api=1&query={{ (restaurant.adrRestau ~ ' ' ~ restaurant.cpRestau ~ ' ' ~ restaurant.villeRestau)|url_encode }}" target="_blank" class="text-decoration-none text-dark">
                        <p class="mb-0">{{ restaurant.adrRestau }}</p>
                        <p class="text-muted">{{ restaurant.cpRestau }} {{ restaurant.villeRestau }}</p>
                    </a>
                </div>
            </div>

            <div class="col-md-4 mb-4">
                <div class="info-card">
                    <i class="fa fa-phone fa-3x mb-3"></i>
                    <h4>Contact</h4>
                    <p class="mb-0"><a href="tel:+33{{ restaurant.telRestau|slice(1) }}" class="text-decoration-none text-dark">+33 {{ restaurant.telRestau|slice(1, 1) }} {{ restaurant.telRestau|slice(2, 2) }} {{ restaurant.telRestau|slice(4, 2) }} {{ restaurant.telRestau|slice(6, 2) }} {{ restaurant.telRestau|slice(8, 2) }}</a></p>
                    <p><a href="mailto:{{ restaurant.emailRestau }}" class="text-decoration-none text-dark">{{ restaurant.emailRestau }}</a></p>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
