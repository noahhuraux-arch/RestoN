{% extends 'base.html.twig' %}

{% block title %}Accueil - {{ restaurant.libRestau }}{% endblock %}

{% block favicon %}<link rel="icon" href="{{ asset('images/logos/logo' ~ restaurant.id ~ '.png') }}">{% endblock %}

{% block navbar_brand %}
    <a class="navbar-brand" href="{{ path('app_restaurant_home', {id: restaurant.id}) }}">
        <img src="{{ asset('images/logos/logo' ~ restaurant.id ~ '.png') }}" alt="{{ restaurant.libRestau }} Logo" width="50" height="50" class="d-inline-block align-middle me-2">
        {{ restaurant.libRestau }}
    </a>
{% endblock %}

{% block body %}
    <div class="container">
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

        <div class="home-section" style="background-image: url('{{ asset('images/thumbnails/thumbnail' ~ restaurant.id ~ '.png') }}'); height: 60vh;">
            <div class="home-overlay"></div>
            <div class="home-content">
                <h1 class="display-3 fw-bold">{{ restaurant.libRestau }}</h1>
                <p class="lead mb-4">Une expérience culinaire authentique et moderne.</p>
                <div class="d-grid gap-2 d-sm-flex justify-content-sm-center">
                    <a href="{{ path('app_produit', {idRestau: restaurant.id}) }}" class="btn btn-warning btn-lg px-4 gap-3">Voir la Carte</a>
                    <a href="{{ path('app_reservation_creer', {id: restaurant.id}) }}" class="btn btn-light btn-lg px-4">Réserver une table</a>
                </div>
            </div>
        </div>

        <div class="row mb-5">
            <div class="col-md-4 mb-4">
                <div class="info-card">
                    <i class="fa fa-clock fa-3x mb-3"></i>
                    <h4>Horaires d'aujourd'hui</h4>
                    <p class="mb-0 text-uppercase">{{ nom_jour_actuel }}</p>
                    <p class="fw-bold">{{ texte_horaire_actuel }}</p>
                </div>
            </div>

            <div class="col-md-4 mb-4">
                <div class="info-card">
                    <i class="fa fa-map-marker-alt fa-3x mb-3"></i>
                    <h4>Nous trouver</h4>
                    <p class="mb-0">{{ restaurant.adrRestau }}</p>
                    <p class="text-muted">{{ restaurant.cpRestau }} {{ restaurant.villeRestau }}</p>
                </div>
            </div>

            <div class="col-md-4 mb-4">
                <div class="info-card">
                    <i class="fa fa-phone fa-3x mb-3"></i>
                    <h4>Contact</h4>
                    <p class="mb-0"><a href="tel:{{ restaurant.telRestau }}" class="text-decoration-none text-dark">{{ restaurant.telRestau }}</a></p>
                    <p><a href="mailto:{{ restaurant.emailRestau }}" class="text-decoration-none text-dark">{{ restaurant.emailRestau }}</a></p>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
