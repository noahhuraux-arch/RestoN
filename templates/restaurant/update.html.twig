{% extends 'base.html.twig' %}

{% block title %}Modification du Restaurant{% endblock %}

{% block body %}
    <div class="container py-5">
        <h1 class="mb-4">Modification un restaurant</h1>

        <div class="card shadow-sm">
            <div class="card-body">

                {{ form_start(form) }}

                {{ form_row(form.libRestau) }}
                {{ form_row(form.adrRestau) }}

                <div class="row">
                    <div class="col-md-4">
                        {{ form_row(form.cpRestau) }}
                    </div>
                    <div class="col-md-8">
                        {{ form_row(form.villeRestau) }}
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        {{ form_row(form.nbEtoiles) }}
                    </div>
                    <div class="col-md-6">
                        {{ form_row(form.nbTable) }}
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        {{ form_row(form.tel_restau) }}
                    </div>
                    <div class="col-md-6">
                        {{ form_row(form.email_restau) }}
                    </div>
                </div>


                {{ form_widget(form) }}

                <div class="mt-4 d-grid gap-2 d-md-flex justify-content-md-end">
                    <button type="submit" class="btn btn-primary px-4">
                        Modifier
                    </button>
                </div>

                {{ form_end(form) }}

            </div>
        </div>
    </div>
{% endblock %}
