{% block title %}{% endblock %}

{% block body %}
    <div class="container py-5">
        {% if submit_label == 'Modifier' %}
            <h1 class="mb-4">Modification du restaurant - {{ restaurant.libRestau }}</h1>
        {% elseif submit_label == 'Créer' %}
            <h1 class="mb-4">Création d'un réstaurant</h1>
        {% endif %}

        <div class="card shadow-sm">
            <div class="card-body">

                {{ form_start(form, {'attr': {'enctype': 'multipart/form-data'}}) }}

                <h5 class="text-primary mb-3">Informations générales</h5>
                <div class="row">
                {{ form_row(form.libRestau) }}
                {{ form_row(form.adrRestau) }}

                <div class="row">
                    <div class="col-md-4">
                        {{ form_row(form.cpRestau) }}
                    </div>
                    <div class="col-md-8">
                        {{ form_row(form.villeRestau) }}
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        {{ form_row(form.nbEtoiles) }}
                    </div>
                    <div class="col-md-6">
                        {{ form_row(form.nbTable) }}
                    </div>
                </div>
                </div>

                <hr class="my-4 text-light">
                <h5 class="text-primary mb-3">Contact</h5>
                <div class="row">
                    <div class="col-md-6">
                        {{ form_row(form.tel_restau) }}
                    </div>
                    <div class="col-md-6">
                        {{ form_row(form.email_restau) }}
                    </div>
                </div>

                <hr class="my-4 text-light">
                <h5 class="text-primary mb-3">Identité Visuelle</h5>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        {{ form_row(form.logoFile) }}
                    </div>
                    <div class="col-md-6 mb-3">
                        {{ form_row(form.banniereFile) }}
                    </div>
                </div>

                {{ form_rest(form) }}

                <div class="mt-4 d-flex justify-content-end gap-2">
                    {% if submit_label == 'Modifier' %}
                        <a href="{{ path('app_proprietaire_show', {'id': restaurant.id}) }}" class="btn btn-outline-secondary">
                            Annuler
                        </a>
                    {% else %}
                        <a href="{{ path('app_proprietaire') }}" class="btn btn-outline-secondary">
                            Annuler
                        </a>
                    {% endif %}

                    <button type="submit" class="btn btn-primary px-5 shadow-sm">
                        {{ submit_label }}
                    </button>
                </div>

                {{ form_end(form) }}

            </div>
        </div>
    </div>
{% endblock %}
