{% extends 'base.html.twig' %}

{% block title %}Resto'N - Solution de Gestion de Restaurant{% endblock %}

{% block body %}
    <div class="container">
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

        <div class="home-section" style="background-color: #2c3e50; height: 50vh;">
            <div class="home-overlay" style="background: none;"></div>
            <div class="home-content">
                <h1 class="display-3 fw-bold">Resto'N</h1>
                <p class="lead mb-4">Besoin de gérer votre restaurant ? Contactez-nous !</p>

                <div class="d-grid gap-3 d-sm-flex justify-content-sm-center">
                    <a href="#" class="btn btn-warning btn-lg px-4">S'inscrire</a>
                    <a href="#" class="btn btn-light btn-lg px-4">Plus d'informations</a>
                </div>
            </div>
        </div>

        <div class="text-center my-5">
            <h2 class="mb-4">Nos Partenaires</h2>

            <div id="partnerCarousel" class="carousel slide" data-bs-ride="carousel" data-bs-interval="3000">
                <div class="carousel-inner p-3">

                    <div class="carousel-item active">
                        <div class="row justify-content-center align-items-center">
                            <div class="col-4">
                                <img src="{{ asset('images/logo1.png') }}" class="d-block w-100 img-fluid" alt="Logo Partenaire 1" style="max-height: 100px; object-fit: contain;">
                            </div>
                            <div class="col-4">
                                <img src="{{ asset('images/logo2.png') }}" class="d-block w-100 img-fluid" alt="Logo Partenaire 2" style="max-height: 100px; object-fit: contain;">
                            </div>
                            <div class="col-4">
                                <img src="{{ asset('images/logo3.png') }}" class="d-block w-100 img-fluid" alt="Logo Partenaire 3" style="max-height: 100px; object-fit: contain;">
                            </div>
                        </div>
                    </div>

                    <div class="carousel-item">
                        <div class="row justify-content-center align-items-center">
                            <div class="col-4">
                                <img src="{{ asset('images/logo4.png') }}" class="d-block w-100 img-fluid" alt="Logo Partenaire 4" style="max-height: 100px; object-fit: contain;">
                            </div>
                            <div class="col-4">
                                <img src="{{ asset('images/logo5.png') }}" class="d-block w-100 img-fluid" alt="Logo Partenaire 5" style="max-height: 100px; object-fit: contain;">
                            </div>
                            <div class="col-4">
                                <img src="{{ asset('images/logo6.png') }}" class="d-block w-100 img-fluid" alt="Logo Partenaire 6" style="max-height: 100px; object-fit: contain;">
                            </div>
                        </div>
                    </div>

                </div>

                <button class="carousel-control-prev" type="button" data-bs-target="#partnerCarousel" data-bs-slide="prev">
                    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Previous</span>
                </button>
                <button class="carousel-control-next" type="button" data-bs-target="#partnerCarousel" data-bs-slide="next">
                    <span class="carousel-control-next-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Next</span>
                </button>
            </div>
        </div>
    </div>
{% endblock %}
