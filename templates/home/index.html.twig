{% extends 'base.html.twig' %}

{% block title %}Resto'N - Solution de Gestion de Restaurant{% endblock %}

{% block body %}
    <div class="container">
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

        <div class="home-section" style="background-color: #2c3e50; height: 50vh;">
            <div class="home-overlay" style="background: none;"></div>
            <div class="home-content">
                <h1 class="display-3 fw-bold">Resto'N</h1>
                <p class="lead mb-4">Besoin de gérer votre restaurant ? Contactez-nous !</p>

                <div class="d-grid gap-3 d-sm-flex justify-content-sm-center">
                    <a href="#" class="btn btn-warning btn-lg px-4">S'inscrire</a>
                    <a href="#about" class="btn btn-light btn-lg px-4">Plus d'informations</a>
                </div>
            </div>
        </div>

        <div id="about" class="row py-5 align-items-center justify-content-center">
            <div class="col-lg-8 col-md-10">
                <div class="p-5 bg-light rounded-3 shadow-sm text-center">
                    <h2 class="mb-4 fw-bold text-dark">À propos de Resto'N</h2>

                    <p class="lead text-secondary mb-4" style="line-height: 1.8;">
                        Resto'N est la solution SaaS innovante conçue pour simplifier le quotidien des restaurateurs.
                        De la gestion des réservations à la mise à jour de votre carte en temps réel,
                        notre plateforme vous offre tous les outils nécessaires pour développer votre activité et fidéliser vos clients.
                    </p>

                    <hr class="w-25 mx-auto my-4 text-warning" style="opacity: 1; height: 3px;">

                    <p class="fst-italic text-muted">
                        Rejoignez une communauté de professionnels qui ont choisi l'efficacité et la modernité.
                    </p>
                </div>
            </div>
        </div>

        <div id="partenaires" class="text-center my-5">
            <h2 class="mb-4">Nos Partenaires</h2>
            <p class="fst-italic text-muted mb-4">Ils nous ont fait confiance, pourquoi pas vous ?</p>

            <div id="partnerCarousel" class="carousel slide carousel-dark" data-bs-ride="carousel" data-bs-interval="3000">
                <div class="carousel-inner p-3">

                    <div class="carousel-item active">
                        <div class="row justify-content-center align-items-center">
                            <div class="col-4">
                                <a href="{{ path('app_restaurant_home', {id: 1}) }}" class="d-block">
                                <img src="{{ asset('images/logos/logo1.png') }}" class="d-block w-100 img-fluid" alt="Logo Partenaire 1" style="max-height: 200px; object-fit: contain;">
                                </a>
                            </div>
                            <div class="col-4">
                                <a href="{{ path('app_restaurant_home', {id: 2}) }}" class="d-block">
                                <img src="{{ asset('images/logos/logo2.png') }}" class="d-block w-100 img-fluid" alt="Logo Partenaire 2" style="max-height: 200px; object-fit: contain;">
                                </a>
                            </div>
                            <div class="col-4">
                                <a href="{{ path('app_restaurant_home', {id: 3}) }}" class="d-block">
                                <img src="{{ asset('images/logos/logo3.png') }}" class="d-block w-100 img-fluid" alt="Logo Partenaire 3" style="max-height: 200px; object-fit: contain;">
                                </a>
                            </div>
                        </div>
                    </div>

                    <div class="carousel-item">
                        <div class="row justify-content-center align-items-center">
                            <div class="col-4">
                                <a href="{{ path('app_restaurant_home', {id: 4}) }}" class="d-block">
                                <img src="{{ asset('images/logos/logo4.png') }}" class="d-block w-100 img-fluid" alt="Logo Partenaire 4" style="max-height: 200px; object-fit: contain;">
                                </a>
                            </div>
                            <div class="col-4">
                                <a href="{{ path('app_restaurant_home', {id: 5}) }}" class="d-block">
                                <img src="{{ asset('images/logos/logo5.png') }}" class="d-block w-100 img-fluid" alt="Logo Partenaire 5" style="max-height: 200px; object-fit: contain;">
                                </a>
                            </div>
                            <div class="col-4">
                                <a href="{{ path('app_restaurant_home', {id: 6}) }}" class="d-block">
                                <img src="{{ asset('images/logos/logo6.png') }}" class="d-block w-100 img-fluid" alt="Logo Partenaire 6" style="max-height: 200px; object-fit: contain;">
                                </a>
                            </div>
                        </div>
                    </div>

                </div>

                <button class="carousel-control-prev" type="button" data-bs-target="#partnerCarousel" data-bs-slide="prev">
                    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Previous</span>
                </button>
                <button class="carousel-control-next" type="button" data-bs-target="#partnerCarousel" data-bs-slide="next">
                    <span class="carousel-control-next-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Next</span>
                </button>
            </div>
        </div>
    </div>
{% endblock %}
