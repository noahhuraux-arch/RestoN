{% extends 'base.html.twig' %}

{% block title %}Accueil - Resto'N{% endblock %}

{% block body %}
    <div class="container">
        <div class="p-5 mb-4 bg-light rounded-3 text-center">
            <div class="container-fluid py-5">
                <h1 class="display-5 fw-bold">Bienvenue chez Resto'N</h1>
                <p class="col-md-8 fs-4 mx-auto">Découvrez une cuisine authentique et savoureuse. Réservez votre table ou consultez notre carte directement en ligne.</p>
                <div class="d-grid gap-2 d-sm-flex justify-content-sm-center mt-4">
                    <button type="button" class="btn btn-primary btn-lg px-4 gap-3">Voir la Carte</button>
                    <button type="button" class="btn btn-outline-secondary btn-lg px-4">Réserver une table</button>
                </div>
            </div>
        </div>

        <div class="row align-items-md-stretch">
            <div class="col-md-6 mb-4">
                <div class="h-100 p-5 text-white bg-dark rounded-3">
                    <h2>Nos Menus</h2>
                    <p>Une sélection de plats préparés avec des produits frais et de saison. Découvrez nos formules du midi et nos spécialités du chef.</p>
                    <button class="btn btn-outline-light" type="button">Découvrir</button>
                </div>
            </div>
            <div class="col-md-6 mb-4">
                <div class="h-100 p-5 bg-light border rounded-3">
                    <h2>Horaires d'ouverture</h2>
                    <p>Nous sommes ouverts du mardi au dimanche.</p>
                    <ul class="list-unstyled">
                        <li>Mardi - Samedi : 12h00 - 14h30 | 19h00 - 22h30</li>
                        <li>Dimanche : 12h00 - 15h00</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
