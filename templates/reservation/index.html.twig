{% extends 'base.html.twig' %}

{% block title %}Réservations - {{ restaurant.libRestau }}{% endblock %}

{% block favicon %}
    {% if restaurant.logo %}
        <link rel="icon" href="{{ asset('images/logos/' ~ restaurant.logo) }}">
    {% else %}
        <link rel="icon" href="{{ asset('images/favicon.png') }}">
    {% endif %}
{% endblock %}

{% block body %}
    <div class="container py-5">
        <div class="d-flex flex-column flex-xl-row justify-content-between align-items-center mb-4 gap-3">
            <h1 class="h3 fw-bold mb-0 text-center text-xl-start">Réservations</h1>
            <div class="d-flex flex-column flex-md-row align-items-center gap-2 w-100 w-xl-auto">
                <form class="d-flex m-0 w-100 w-md-auto" role="search" action="{{ path('app_reservation', {id: restaurant.id}) }}">
                    <input class="form-control me-2" type="search" name="searchText" placeholder="Recherche" aria-label="search" value="{{ searchText|default('') }}"/>
                    <button class="btn btn-outline-success" type="submit">Recherche</button>
                </form>
                <div class="d-flex flex-wrap justify-content-center gap-2 w-100 w-md-auto">
                    <a href="{{ path('app_reservation', {id: restaurant.id}) }}" class="btn fw-bold shadow-sm flex-grow-1 flex-md-grow-0 {{ app.request.get('filter') is null ? 'btn-warning' : 'btn-outline-warning' }}">
                        Toutes
                    </a>
                    <a href="{{ path('app_reservation', {id: restaurant.id, filter: 'today'}) }}" class="btn fw-bold shadow-sm flex-grow-1 flex-md-grow-0 {{ app.request.get('filter') == 'today' ? 'btn-warning' : 'btn-outline-warning' }}">
                        Aujourd'hui
                    </a>
                    {% set currentOrder = app.request.get('order') ?? 'desc' %}
                    {% set nextOrder = currentOrder == 'asc' ? 'desc' : 'asc' %}

                    <a href="{{ path('app_reservation', {
                        id: restaurant.id,
                        filter: app.request.get('filter'),
                        searchText: app.request.get('searchText'),
                        order: nextOrder
                        }) }}"
                       class="btn fw-bold shadow-sm flex-grow-1 flex-md-grow-0
                        {{ currentOrder == 'asc' ? 'btn-outline-warning' : 'btn-warning' }}">
                        <i class="bi {{ currentOrder == 'asc' ? 'bi-arrow-down' : 'bi-arrow-up' }} me-1"></i>
                        {{ currentOrder == 'asc' ? 'Date' : 'Date' }}
                    </a>

                    <a href="{{ path('app_restaurant_home', {id: restaurant.id}) }}" class="btn btn-outline-secondary fw-bold shadow-sm bi bi-arrow-left flex-grow-1 flex-md-grow-0">
                        Retour
                    </a>
                    <a href="{{ path('app_reservation_create', {id: restaurant.id}) }}" class="btn btn-warning fw-bold shadow-sm bi bi-plus-lg flex-grow-1 flex-md-grow-0">
                        Créer
                    </a>
                </div>
            </div>
        </div>
        <div class="row g-4">
            {% for reservation in reservations %}
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 border-0 shadow-sm hover-lift overflow-hidden">
                        <div class="card-body p-0">
                            <div class="bg-warning p-3 d-flex justify-content-between align-items-center border-bottom">
                                <span class="fw-bold bi bi-calendar3 me-1 text-dark"> {{ reservation.date|date('d/m/Y') }}</span>
                                <span class="badge bg-dark">{{ reservation.heure|date('H:i') }}</span>
                            </div>
                            <div class="p-3">
                                <small class="text-muted d-block text-uppercase fw-bold" style="font-size: 0.7rem;">Client</small>
                                <h5 class="fw-bold text-dark mb-2">{{ reservation.client.prenom }} {{ reservation.client.nom }}</h5>
                                <div class="d-flex align-items-center text-muted">
                                    <i class="bi bi-people me-2 text-warning"></i>
                                    <span>{{ reservation.nbPers }} couverts</span>
                                </div>
                            </div>
                        </div>
                        <div class="card-footer bg-white border-0 p-3 d-flex justify-content-between">
                            <div class="d-flex gap-2">
                                <a href="{{ path('app_reservation_show', {id: restaurant.id, idReservation: reservation.id}) }}" class="btn btn-sm btn-warning fw-bold shadow-sm">
                                    Voir détails
                                </a>
                                <a href="{{ path('app_reservation_update', {id: restaurant.id, idReservation: reservation.id}) }}" class="btn btn-sm btn-warning fw-bold shadow-sm">
                                    Modifier
                                </a>
                            </div>
                            <a href="{{ path('app_reservation_delete', {id: restaurant.id, idReservation: reservation.id}) }}" class="btn btn-sm btn-outline-danger shadow-sm bi bi-trash">
                            </a>
                        </div>
                    </div>
                </div>
            {% else %}
                <div class="col-12 text-center py-5">
                    <i class="bi bi-calendar-x display-1 text-muted"></i>
                    <p class="h5 text-muted mt-3">Aucune réservation pour le moment.</p>
                </div>
            {% endfor %}
        </div>
    </div>
{% endblock %}
