{% extends 'base.html.twig' %}

{% block title %}Supprimer la réservation n°{{ reservation.id }} - {{ restaurant.libRestau }}{% endblock %}

{% block favicon %}
    {% if restaurant.logo %}
        <link rel="icon" href="{{ asset('images/logos/' ~ restaurant.logo) }}">
    {% else %}
        <link rel="icon" href="{{ asset('images/favicon.png') }}">
    {% endif %}
{% endblock %}

{% block body %}
    <div class="container py-5">
        <div class="alert alert-danger text-center">
            <h1 class="h3"> Attention !</h1>
            <p class="lead">
                Êtes-vous sûr de vouloir supprimer définitivement la réservation de
                <strong>"{{ reservation.client.prenom }} {{ reservation.client.nom }}"</strong> ?
            </p>
            <p class="mb-0">
                Prévue le <strong>{{ reservation.date|date('d/m/Y') }}</strong>
                à <strong>{{ reservation.heure|date('H:i') }}</strong>.
            </p>
            <p>Cette action est irréversible.</p>
        </div>

        <div class="d-flex justify-content-center mt-5">
            {{ form_start(form, {attr: {class: 'd-flex flex-column flex-sm-row gap-3 align-items-center w-100 justify-content-center'}}) }}

            {{ form_widget(form.delete, {
                label: 'Supprimer',
                attr: {class: 'btn btn-danger w-100 w-sm-auto'},
            }) }}

            {{ form_widget(form.cancel, {
                label: 'Annuler',
                attr: {class: 'btn btn-secondary w-100 w-sm-auto'},
            }) }}

            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
