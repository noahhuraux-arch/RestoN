{% extends 'base.html.twig' %}

{% block title %}Réserver {% endblock %}
{% block javascripts %}
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const form = document.getElementById('reservation_form');
            const dateInput = document.getElementById('reservation_date');
            const nbPersInput = document.getElementById('reservation_nbPers');

            const updateForm = async () => {
                const data = new FormData(form);
                const response = await fetch(window.location.href, {
                    method: 'POST',
                    body: data,
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                });

                const html = await response.text();
                const parser = new DOMParser();
                const doc = parser.parseFromString(html, 'text/html');
                const newHeure = doc.getElementById('reservation_heure');
                const oldHeure = document.getElementById('reservation_heure');
                if (newHeure && oldHeure) {
                    oldHeure.innerHTML = newHeure.innerHTML;
                }
            };

            dateInput.addEventListener('change', updateForm);
            nbPersInput.addEventListener('input', updateForm);
        });
    </script>
{% endblock %}

{% block body %}
    <div class="container my-5">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="card shadow border-0">
                    <div class="card-body p-5">
                        <h1 class="text-center mb-4 fw-bold">Réserver votre table</h1>

                        {{ form_start(form, {attr: {id: 'reservation_form'}}) }}

                        <div class="row g-3">
                            <div class="col-md-6">
                                {{ form_row(form.client.nom, {label: 'Nom'}) }}
                            </div>
                            <div class="col-md-6">
                                {{ form_row(form.client.prenom, {label: 'Prénom'}) }}
                            </div>
                            <div class="col-md-6">
                                {{ form_row(form.client.email, {label: 'E-mail'}) }}
                            </div>
                            <div class="col-md-6">
                                {{ form_row(form.client.telephone, {label: 'Téléphone'}) }}
                            </div>
                            <div class="col-md-6">
                                {{ form_row(form.date, {label: 'Date'}) }}
                            </div>
                            <div class="col-md-6">
                                {{ form_row(form.nbPers, {label: 'Nombre de personnes'}) }}
                            </div>
                            <div class="col-12">
                                {{ form_row(form.heure, {label: 'Heure'}) }}
                            </div>
                        </div>

                        {{ form_rest(form) }}

                        <div class="d-grid mt-4">
                            <button type="submit" class="btn btn-warning btn-lg text-white">Valider</button>
                        </div>

                        {{ form_end(form) }}
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
