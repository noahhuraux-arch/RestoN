{% extends 'base.html.twig' %}

{% block title %}Réserver - {{ restaurant.libRestau }}{% endblock %}
{% block favicon %}<link rel="icon" href="{{ asset('images/logos/logo' ~ restaurant.id ~ '.png') }}">{% endblock %}
{% block javascripts %}
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const form = document.getElementById('reservation_form');
            const dateInput = document.getElementById('reservation_date');
            const nbPersInput = document.getElementById('reservation_nbPers');

            const updateForm = async () => {
                const data = new FormData(form);
                const response = await fetch(window.location.href, {
                    method: 'POST',
                    body: data,
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                });

                const html = await response.text();
                const parser = new DOMParser();
                const doc = parser.parseFromString(html, 'text/html');
                const newHeure = doc.getElementById('reservation_heure');
                const oldHeure = document.getElementById('reservation_heure');
                if (newHeure && oldHeure) {
                    oldHeure.innerHTML = newHeure.innerHTML;
                }
            };

            dateInput.addEventListener('change', updateForm);
            nbPersInput.addEventListener('input', updateForm);
        });
    </script>
{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-warning text-black text-center py-3">
                    <h1 class="h4 mb-0">Réserver votre table</h1>
                </div>
                <div class="card-body p-3 p-md-4">

                    {{ form_start(form, {attr: {id: 'reservation_form', class: 'needs-validation'}}) }}

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            {{ form_row(form.client.prenom, {label: 'Prénom'}) }}
                        </div>
                        <div class="col-md-6 mb-3">
                            {{ form_row(form.client.nom, {label: 'Nom'}) }}
                        </div>
                    </div>

                    <div class="mb-3">
                        {{ form_row(form.client.email, {label: 'E-mail', attr: {placeholder: 'exemple@mail.com'}}) }}
                    </div>

                    <div class="mb-3">
                        {{ form_row(form.client.telephone, {label: 'Téléphone'}) }}
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            {{ form_row(form.date, {label: 'Date'}) }}
                        </div>
                        <div class="col-md-6 mb-3">
                            {{ form_row(form.nbPers, {label: 'Personnes'}) }}
                        </div>
                    </div>
                    <div class="mb-3">
                        {{ form_row(form.heure, {label: 'Heure'}) }}
                    </div>

                    {{ form_rest(form) }}

                    <div class="d-grid gap-2 mt-4">
                        <button type="submit" class="btn btn-warning btn-lg">
                            Confirmer la réservation
                        </button>
                        <a href="{{ path('app_restaurant_home', {id: restaurant.id}) }}"  class="btn btn-link text-muted">Annuler</a>
                    </div>
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
