{% extends 'base.html.twig' %}

{% block title %}Détails Réservation n°{{ reservations.id }} - {{ restaurant.libRestau }}{% endblock %}

{% block favicon %}
    {% if restaurant.logo %}
        <link rel="icon" href="{{ asset('images/logos/' ~ restaurant.logo) }}">
    {% else %}
        <link rel="icon" href="{{ asset('images/favicon.png') }}">
    {% endif %}
{% endblock %}

{% block body %}
    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-6">
                <div class="card shadow border-0">
                    <div class="card-header bg-warning text-black py-3">
                        <h1 class="h5 mb-0 text-center bi bi-info-circle me-2">
                            Détail de la réservation
                        </h1>
                    </div>
                    <div class="card-body p-0">
                        <ul class="list-group list-group-flush border-0">
                            <li class="list-group-item py-3 border-0">
                                <div class="row">
                                    <div class="col-12 col-sm-6 mb-2 mb-sm-0">
                                        <small class="text-muted d-block text-uppercase" style="font-size: 0.75rem;">Client</small>
                                        <span
                                            class="h6 mb-0 fw-bold">{{ reservations.client.prenom }} {{ reservations.client.nom }}</span>
                                    </div>
                                    <div class="col-12 col-sm-6">
                                        <small class="text-muted d-block text-uppercase" style="font-size: 0.75rem;">Numero
                                            de Reservation</small>
                                        <span class="h6 mb-0 fw-bold">{{ reservations.numero }}</span>
                                    </div>
                                </div>
                            </li>
                            <li class="list-group-item py-3 border-0">
                                <div class="row">
                                    <div class="col-12 col-sm-6 mb-2 mb-sm-0">
                                        <small class="text-muted d-block text-uppercase " style="font-size: 0.75rem;">Téléphone</small>
                                        <span
                                            class="fw-bold">{{ reservations.client.telephone|slice(0, -4) ~ '****' }}</span>
                                    </div>
                                    <div class="col-12 col-sm-6 text-break">
                                        <small class="text-muted d-block text-uppercase" style="font-size: 0.75rem;">Email</small>
                                        <span class="fw-bold">{{ reservations.client.email
                                            |split('')
                                            |map(c => (c == '@' or c == '.') ? c : '*')
                                            |join }}</span>
                                    </div>
                                </div>
                            </li>
                            <li class="list-group-item py-3  border-0">
                                <div class="row text-center">
                                    <div class="col-4 border-0">
                                        <small class="text-muted d-block text-uppercase" style="font-size: 0.65rem;">Date</small>
                                        <span class="fw-bold">{{ reservations.date|date('d/m/Y') }}</span>
                                    </div>
                                    <div class="col-4 border-0">
                                        <small class="text-muted d-block text-uppercase" style="font-size: 0.65rem;">Heure</small>
                                        <span class="fw-bold">{{ reservations.heure|date('H:i') }}</span>
                                    </div>
                                    <div class="col-4">
                                        <small class="text-muted d-block text-uppercase" style="font-size: 0.65rem;">Couverts</small>
                                        <span class="fw-bold">{{ reservations.nbPers }} pers.</span>
                                    </div>
                                </div>
                            </li>

                            <li class="list-group-item py-3 border-0">
                                <small class="text-muted d-block text-uppercase" style="font-size: 0.75rem;">Table
                                    assignée</small>
                                <span class="fw-bold">N°{{ reservations.table.numero }}</span>
                            </li>
                        </ul>
                    </div>

                    <div
                        class="card-footer bg-white py-3 d-flex flex-column flex-sm-row justify-content-between gap-2 border-0">
                        <a href="{{ path('app_reservation', {id: restaurant.id}) }}"
                           class="btn btn-outline-secondary order-2 order-sm-1">
                            <span class="bi bi-arrow-left me-1"> Retour</span>
                        </a>
                        <div class="d-flex flex-column flex-sm-row gap-2 order-1 order-sm-2">
                            {% if reservations.status == 'Reservee' %}
                                <a href="{{ path('app_reservation_installer', {reservation: reservations.id}) }}"
                                   class="btn btn-warning fw-bold">
                                    Installer
                                </a>
                            {% endif %}
                            {% if reservations.status == 'Occupee' %}
                                <a href="{{ path('app_reservation_liberer', {reservation: reservations.id}) }}"
                                   class="btn btn-danger fw-bold">
                                    Libérer la table
                                </a>
                            {% endif %}
                            <a href="{{ path('app_reservation_delete', {id: restaurant.id, idReservation: reservations.id}) }}"
                               class="btn btn-danger">
                                <span class="bi bi-trash me-1"> Supprimer</span>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
