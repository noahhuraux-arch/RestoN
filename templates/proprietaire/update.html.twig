{% extends 'base.html.twig' %}

{% block title %}Modifier mon profil{% endblock %}

{% block body %}
    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-6">
                <div class="card shadow-sm border-0">
                    <div class="card-body p-4">
                        <h1 class="h3 mb-4 fw-normal text-center">Modifier mes informations</h1>

                        {{ form_start(form) }}

                        {{ form_errors(form) }}

                        <div class="row">
                            <div class="col-md-6">{{ form_row(form.prenom) }}</div>
                            <div class="col-md-6">{{ form_row(form.nom) }}</div>
                        </div>

                        <div class="row">
                            <div class="col-md-12">{{ form_row(form.email) }}</div>
                            <div class="col-md-12">{{ form_row(form.telephone) }}</div>
                        </div>

                        {{ form_row(form.password) }}

                        {{ form_rest(form) }}

                        <button type="submit" class="btn btn-success w-100 btn-lg mt-4">
                            Enregistrer les modifications
                        </button>
                        {{ form_end(form) }}

                        <div class="text-center mt-3">
                            <a href="{{ path('app_proprietaire') }}" class="text-decoration-none text-muted small">
                                <i class="bi bi-arrow-left"></i> Retour
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
