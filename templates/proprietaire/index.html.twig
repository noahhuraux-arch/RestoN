{% extends 'base.html.twig' %}

{% block title %}Gestion - {{ restaurant.libRestau }}{% endblock %}

{% block body %}
    <div class="container py-5">
        <div class="card border-0 shadow-sm overflow-hidden mb-4">
            <div style="height: 250px;
            {% if restaurant.banniere %}
                background: url('{{ asset('images/thumbnails/' ~ restaurant.banniere) }}') center/cover no-repeat;
            {% endif %}
                background-color: #343a40;">
                <div class="h-100 w-100" style="background: linear-gradient(transparent, rgba(0,0,0,0.1))"></div>
            </div>

            <div class="card-body position-relative pt-0">
                <div class="d-flex flex-column flex-md-row align-items-end" style="margin-top: -60px;">

                    {% if restaurant.logo %}
                        <div class="position-relative">
                            <img src="{{ asset('images/logos/' ~ restaurant.logo) }}"
                                 alt="Logo {{ restaurant.libRestau }}"
                                 class="rounded-circle border border-4 border-white shadow"
                                 style="width: 130px; height: 130px; object-fit: cover; background: white;">
                        </div>
                    {% else %}
                        <div style="width: 130px; height: 10px;"></div>
                    {% endif %}

                    <div class="ms-md-4 mt-3 mt-md-0 flex-grow-1">
                        <h1 class="h2 fw-bold mb-1 text-dark">
                            {{ restaurant.libRestau }}
                        </h1>
                        <p class="text-muted mb-2">
                            <i class="bi bi-geo-alt-fill me-1"></i>{{ restaurant.villeRestau }}
                        </p>
                    </div>

                    <div class="mt-3 mt-md-0 d-flex gap-2 pb-2">
                        <a href="{{ path('app_restaurant_home', {id: restaurant.id}) }}" class="btn btn-outline-dark shadow-sm">
                            <i class="bi bi-eye me-1"></i> Voir le restaurant
                        </a>
                        <a href="{{ path('app_restaurant_update', {id: restaurant.id}) }}" class="btn btn-primary shadow-sm">
                            <i class="bi bi-camera me-1"></i> Modifier photos / infos
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-3 mb-4">
            <div class="col-6 col-md-3">
                <a href="{{ path('app_restaurant_reservations', {id: restaurant.id}) }}" class="btn btn-white w-100 py-3 shadow-sm border-0 h-100 text-decoration-none">
                    <i class="bi bi-calendar-check text-primary fs-3 d-block mb-2"></i>
                    <span class="fw-bold text-dark">Réservations</span>
                </a>
            </div>
            <div class="col-6 col-md-3">
                <a href="{{ path('app_produit_proprietaire', {idRestau: restaurant.id}) }}" class="btn btn-white w-100 py-3 shadow-sm border-0 h-100 text-decoration-none">
                    <i class="bi bi-egg-fried text-success fs-3 d-block mb-2"></i>
                    <span class="fw-bold text-dark">La Carte</span>
                </a>
            </div>
            <div class="col-6 col-md-3">
                <a href="{{ path('app_serveur_show', {id: restaurant.id}) }}" class="btn btn-white w-100 py-3 shadow-sm border-0 h-100 text-decoration-none">
                    <i class="bi bi-people text-info fs-3 d-block mb-2"></i>
                    <span class="fw-bold text-dark">L'Équipe</span>
                </a>
            </div>
            <div class="col-6 col-md-3">
                <a href="{{ path('app_restaurant_delete', {id: restaurant.id}) }}" class="btn btn-white w-100 py-3 shadow-sm border-0 h-100 text-danger text-decoration-none">
                    <i class="bi bi-trash fs-3 d-block mb-2"></i>
                    <span class="fw-bold">Supprimer</span>
                </a>
            </div>
        </div>

        <div class="row g-4">
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body p-4">
                        <h5 class="fw-bold mb-4 text-dark border-bottom pb-2">Détails de l'établissement</h5>

                        <div class="row g-4">
                            <div class="col-md-6">
                                <label class="small text-muted text-uppercase fw-bold">Adresse</label>
                                <p class="fs-5 text-dark">
                                    <i class="bi bi-house-door me-2 text-primary"></i>{{ restaurant.adrRestau }}<br>
                                    <span class="ms-4 small text-muted">{{ restaurant.cpRestau }} {{ restaurant.villeRestau }}</span>
                                </p>
                            </div>
                            <div class="col-md-6">
                                <label class="small text-muted text-uppercase fw-bold">Contact</label>
                                <p class="fs-5 mb-1 text-dark"><i class="bi bi-telephone me-2 text-primary"></i>{{ restaurant.telRestau }}</p>
                                <p class="fs-5 text-dark"><i class="bi bi-envelope me-2 text-primary"></i>{{ restaurant.emailRestau }}</p>
                            </div>
                            <div class="col-md-6">
                                <label class="small text-muted text-uppercase fw-bold">Autres</label>
                                <div class="d-flex gap-3 mt-2">
                                    <span class="badge bg-light text-dark border p-2 fw-normal">
                                        <i class="bi bi-layout-three-columns me-1 text-primary"></i> {{ restaurant.nbTable }} Tables
                                    </span>
                                    {% if restaurant.nbEtoiles %}
                                        <span class="badge bg-light text-dark border p-2 fw-normal">
                                            <i class="bi bi-star-fill me-1 text-warning"></i> {{ restaurant.nbEtoiles }} Étoiles
                                        </span>
                                    {% endif %}
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <h5 class="fw-bold mb-0 text-dark">Horaires</h5>
                            <a href="{{ path('app_restaurant_horaires', {id: restaurant.id}) }}" class="btn btn-sm btn-light border" title="Modifier les horaires">
                                <i class="bi bi-clock-history"></i>
                            </a>
                        </div>

                        {% for horaire in restaurant.horaires %}
                            <div class="d-flex justify-content-between py-2 border-bottom border-light">
                                <span class="fw-medium text-dark">{{ horaire.jour }}</span>
                                <div class="text-end small">
                                    {% if horaire.ferme %}
                                        <span class="badge bg-danger-subtle text-danger">Fermé</span>
                                    {% else %}
                                        {% if horaire.ouvertureMidi %}
                                            <div class="text-dark">{{ horaire.ouvertureMidi|date('H:i') }} - {{ horaire.fermetureMidi|date('H:i') }}</div>
                                        {% endif %}
                                        {% if horaire.ouvertureSoir %}
                                            <div class="text-dark">{{ horaire.ouvertureSoir|date('H:i') }} - {{ horaire.fermetureSoir|date('H:i') }}</div>
                                        {% endif %}
                                    {% endif %}
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
