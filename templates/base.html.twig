<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>{% block title %}Resto'N{% endblock %}</title>
    {% block favicon %}<link rel="icon" href="{{ asset('images/favicon.png') }}">{% endblock %}
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
    {% block stylesheets %}{% endblock %}
</head>
<body>
<nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4 sticky-top">
    <div class="container">
        {% block navbar_brand %}
            <a class="navbar-brand" href="{{ path('app_home') }}"><img src="{{ asset('images/favicon.png') }}" alt="Logo" width="50" height="50" class="d-inline-block align-middle me-2" style="filter: invert(1);">
                Resto'N
            </a>
        {% endblock %}
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav ms-auto">
                {% set current_route = app.request.attributes.get('_route') %}

                {% if current_route == 'app_home' %}
                    <li class="nav-item">
                        <a class="nav-link active" href="{{ path('app_home') }}">Accueil</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#about">À Propos</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#partenaires">Nos Partenaires</a>
                    </li>
                {% elseif current_route == 'app_restaurant_home' %}
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('app_restaurant_home', {id: app.request.get('id')}) }}">Accueil</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#">La Carte</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#">Réservations</a>
                    </li>
                {% else %}
                    <li class="nav-item">
                        <a class="nav-link" href="#">Lien À Compléter</a>
                    </li>
                {% endif %}

                <li class="nav-item">
                    <a class="nav-link" href="#">Connexion</a>
                </li>
            </ul>
        </div>
    </div>
</nav>

{% block body %}{% endblock %}

<footer class="bg-dark text-white pt-5 pb-4 mt-auto">
    <div class="container text-center text-md-start">
        <div class="row text-center text-md-start">

            <div class="col-md-3 col-lg-3 col-xl-3 mx-auto mt-3">
                <h5 class="text-uppercase mb-4 fw-bold text-warning">
                    <img src="{{ asset('images/favicon.png') }}" alt="Logo" width="25" height="25" class="d-inline-block align-text-top me-2" style="filter: invert(1);">
                    Resto'N
                </h5>
                <p><strong>La</strong> solution pour la gestion de restaurants. Simple, rapide et efficace.</p>
            </div>

            <div class="col-md-2 col-lg-2 col-xl-2 mx-auto mt-3">
                <h5 class="text-uppercase mb-4 fw-bold text-warning">Accès rapide</h5>
                <p><a href="{{ path('app_home') }}" class="text-white text-decoration-none">Accueil</a></p>
                <p><a href="{{ path('app_home') }}#about" class="text-white text-decoration-none">À Propos</a></p>
                <p><a href="{{ path('app_home') }}#partenaires" class="text-white text-decoration-none">Partenaires</a></p>
            </div>

            <div class="col-md-4 col-lg-3 col-xl-3 mx-auto mt-3">
                <h5 class="text-uppercase mb-4 fw-bold text-warning">Contact</h5>
                <p><i class="fas fa-home me-2"></i> Resto'N, Reims</p>
                <p><i class="fas fa-envelope me-2"></i> contact@reston.fr</p>
                <p><i class="fas fa-phone me-2"></i> +33 1 23 45 67 89</p>
            </div>

        </div>

        <hr class="mb-4">

        <div class="row align-items-center">
            <div class="col-12 text-center">
                <p>© 2025 <strong>Resto'N</strong> - Tous Droits Réservés</p>
            </div>
        </div>
    </div>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
{% block javascripts %}{% endblock %}
</body>
</html>
