<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>{% block title %}Resto'N{% endblock %}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    {% block favicon %}<link rel="icon" href="{{ asset('images/favicon.png') }}">{% endblock %}
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Playfair:ital,opsz,wght@0,5..1200,300..900;1,5..1200,300..900&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400..700;1,400..700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
    {% block stylesheets %}{% endblock %}
</head>
<body class="d-flex flex-column min-vh-100">
<nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4 sticky-top">
    <div class="container">

        {% block navbar_brand %}
            {% if restaurant is defined and restaurant is not null and restaurant.id is defined %}
                <a class="navbar-brand" href="{{ path('app_restaurant_home', {id: restaurant.id}) }}">
                    {% if restaurant.logo %}
                        <img src="{{ asset('images/logos/' ~ restaurant.logo) }}"
                             alt="{{ restaurant.libRestau }}"
                             width="50" height="50"
                             class="d-inline-block align-middle me-2 rounded-circle"
                             style="object-fit: cover;">
                    {% else %}
                        <img src="{{ asset('images/favicon.png') }}"
                             alt="Logo" width="50" height="50"
                             class="d-inline-block align-middle me-2"
                             style="filter: invert(1);">
                    {% endif %}
                    {{ restaurant.libRestau }}
                </a>
            {% else %}
                <a class="navbar-brand" href="{{ path('app_home') }}">
                    <img src="{{ asset('images/favicon.png') }}"
                         alt="Logo Resto'N" width="50" height="50"
                         class="d-inline-block align-middle me-2"
                         style="filter: invert(1);">
                    Resto'N
                </a>
            {% endif %}
        {% endblock %}

        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav ms-auto">
                {% set current_route = app.request.attributes.get('_route') %}
                {% set restauId = app.request.get('id') ? app.request.get('id') : app.request.get('idRestau') %}

                {% if current_route == 'app_produit_details' and produit is defined %}
                    {% set restauId = produit.idRestau.id %}
                {% endif %}

                {% if current_route == 'app_home' %}
                    <li class="nav-item">
                        <a class="nav-link active" href="{{ path('app_home') }}">Accueil</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#about">À Propos</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#partenaires">Nos Partenaires</a>
                    </li>

                {% elseif restauId %}
                    <li class="nav-item">
                        <a class="nav-link {{ current_route == 'app_restaurant_home' ? 'active' : '' }}" href="{{ path('app_restaurant_home', {id: restauId}) }}">Accueil</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link {{ current_route == 'app_produit' ? 'active' : '' }}" href="{{ path('app_produit', {idRestau: restauId}) }}">Carte</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link {{ current_route == 'app_reservation_create' ? 'active' : '' }}" href="{{ path('app_reservation_create', {id: restauId}) }}">Réservations</a>
                    </li>
                {% else %}
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('app_home') }}">Accueil</a>
                    </li>
                {% endif %}
                {% if app.user %}
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle active" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            {{ app.user.nom }}
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end">
                            {% if is_granted('ROLE_PROPRIETAIRE') %}
                                <li><a class="dropdown-item" href="{{ path('app_proprietaire_update') }}">Gérer mon profil</a></li>
                                <li><a class="dropdown-item" href="{{ path('app_proprietaire') }}">Mes restaurants</a></li>
                            {% endif %}
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item text-danger" href="{{ path('app_logout') }}">Déconnexion</a></li>
                        </ul>
                    </li>
                {% else %}
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('app_login') }}">Connexion</a>
                    </li>
                {% endif %}
            </ul>
        </div>
    </div>
</nav>

{% block body %}{% endblock %}

<footer class="bg-dark text-white pt-5 pb-4 mt-auto">
    <div class="container text-center text-md-start">
        <div class="row text-center text-md-start">

            <div class="col-12 col-md-3 col-lg-3 col-xl-3 mx-auto mt-3">
                <h5 class="text-uppercase mb-4 fw-bold">
                    <a href="{{ path('app_home') }}" class="text-warning text-decoration-none">
                        <img src="{{ asset('images/favicon.png') }}" alt="Logo" width="25" height="25" class="d-inline-block align-text-top me-2" style="filter: invert(1);">
                        Resto'N
                    </a>
                </h5>
                <p><strong>La</strong> solution pour la gestion de restaurants. Simple, rapide et efficace.</p>
            </div>

            <div class="col-6 col-md-2 col-lg-2 col-xl-2 mx-auto mt-3">
                <h5 class="text-uppercase mb-4 fw-bold text-warning">Accès rapide</h5>
                <p><a href="{{ path('app_home') }}" class="text-white text-decoration-none">Accueil</a></p>
                <p><a href="{{ path('app_home') }}#about" class="text-white text-decoration-none">À Propos</a></p>
                <p><a href="{{ path('app_home') }}#partenaires" class="text-white text-decoration-none">Partenaires</a></p>
            </div>

            <div class="col-6 col-md-4 col-lg-3 col-xl-3 mx-auto mt-3">
                <h5 class="text-uppercase mb-4 fw-bold text-warning">Contact</h5>
                <p><i class="fas fa-home me-2"></i> Resto'N, Reims</p>

                <p>
                    <i class="fas fa-envelope me-2"></i>
                    <a href="mailto:contact@reston.fr" class="text-white text-decoration-none">contact@reston.fr</a>
                </p>

                <p>
                    <i class="fas fa-phone me-2"></i>
                    <a href="tel:+33123456789" class="text-white text-decoration-none">+33 1 23 45 67 89</a>
                </p>
            </div>

        </div>

        <hr class="mb-4">

        <div class="row align-items-center">
            <div class="col-12 text-center">
                <p>© 2025 <strong>Resto'N</strong> - Tous Droits Réservés</p>
            </div>
        </div>
    </div>
</footer>

<!-- Chatbot Interface -->
<div id="chatbot-container">
    <!-- Fenêtre du Chatbot (cachée par défaut) -->
    <div id="chatbot-window" class="card shadow d-none">
        <div class="card-header bg-warning text-dark d-flex justify-content-between align-items-center">
            <h6 class="mb-0 fw-bold"><i class="fas fa-robot me-2"></i>Assistant Resto'N</h6>
            <button type="button" class="btn-close btn-close-white" aria-label="Close" onclick="toggleChatbot()"></button>
        </div>
        <div class="card-body overflow-auto" style="height: 300px; background-color: #f8f9fa;">
            <div class="d-flex flex-column gap-2" id="chatbot-messages">
                <div class="align-self-start bg-white p-2 rounded shadow-sm border" style="max-width: 80%;">
                    <small class="text-muted d-block mb-1">Assistant</small>
                    Bonjour ! Je suis l'assistant virtuel de Resto'N. Comment puis-je vous aider aujourd'hui ?
                </div>
                {% set chatRestauId = app.request.get('id') ? app.request.get('id') : app.request.get('idRestau') %}
                <div class="d-flex flex-wrap gap-2" id="chatbot-suggestions">
                    {% if chatRestauId %}
                        <button class="btn btn-sm btn-outline-warning rounded-pill" onclick="sendPredefinedMessage('Quels sont les horaires ?')">Horaires</button>
                        <button class="btn btn-sm btn-outline-warning rounded-pill" onclick="sendPredefinedMessage('Je veux voir la carte')">Carte</button>
                        <button class="btn btn-sm btn-outline-warning rounded-pill" onclick="sendPredefinedMessage('Je souhaite réserver')">Réserver</button>
                    {% else %}
                        <button class="btn btn-sm btn-outline-warning rounded-pill" onclick="sendPredefinedMessage('Comment s\'inscrire ?')">Inscription</button>
                        <button class="btn btn-sm btn-outline-warning rounded-pill" onclick="sendPredefinedMessage('En savoir plus')">Infos</button>
                    {% endif %}
                    <button class="btn btn-sm btn-outline-secondary rounded-pill" onclick="sendPredefinedMessage('Contacter le support')">Support</button>
                </div>
            </div>
        </div>
        <div class="card-footer bg-white">
            <div class="input-group">
                <input type="text" id="chatbot-input" class="form-control border-0" placeholder="Écrivez votre message..." aria-label="Message">
                <button class="btn btn-warning text-white" type="button" onclick="sendMessage()"><i class="fas fa-paper-plane"></i></button>
            </div>
        </div>
    </div>

    <button id="chatbot-toggler" class="btn p-0 rounded-circle shadow-lg" onclick="toggleChatbot()">
        <img src="{{ asset('images/chatbot/logo_chatbot.png') }}" alt="Chatbot" class="img-fluid rounded-circle" style="width: 60px; height: 60px;">
    </button>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script>
    function toggleChatbot() {
        const chatWindow = document.getElementById('chatbot-window');
        chatWindow.classList.toggle('d-none');
    }

    function sendPredefinedMessage(message) {
        addMessage(message, 'user');
        getBotResponse(message);
    }

    function sendMessage() {
        const input = document.getElementById('chatbot-input');
        const message = input.value.trim();
        if (message) {
            addMessage(message, 'user');
            input.value = '';
            getBotResponse(message);
        }
    }

    function addMessage(text, sender) {
        const messagesContainer = document.getElementById('chatbot-messages');
        const msgDiv = document.createElement('div');
        if (sender === 'user') {
            msgDiv.className = 'align-self-end bg-warning text-white p-2 rounded shadow-sm border';
        } else {
            msgDiv.className = 'align-self-start bg-white p-2 rounded shadow-sm border';
        }
        msgDiv.style.maxWidth = '80%';
        msgDiv.textContent = text;
        messagesContainer.appendChild(msgDiv);
        const cardBody = document.querySelector('#chatbot-window .card-body');
        cardBody.scrollTop = cardBody.scrollHeight;
    }

    function getBotResponse(text) {
        setTimeout(function() {
            let response = "Je ne suis pas sûr de comprendre. Pouvez-vous préciser ?";
            let msg = text.toLowerCase();

            if (msg.includes('horaire')) {
                response = "Vous trouverez nos horaires d'ouverture sur la page d'accueil du restaurant.";
            } else if (msg.includes('carte')) {
                response = "Vous pouvez consulter l'ensemble de nos plats dans la section 'Carte'.";
            } else if (msg.includes('réserver')) {
                response = "Pour réserver une table, rendez-vous dans l'onglet 'Réservations'.";
            } else if (msg.includes('inscri')) {
                response = "Pour inscrire votre restaurant, utilisez le bouton 'S'inscrire' sur la page d'accueil.";
            } else if (msg.includes('info')) {
                response = "Resto'N est une plateforme complète pour la gestion de votre restaurant.";
            } else if (msg.includes('support') || msg.includes('contact')) {
                response = "Besoin d'aide ? Contactez notre support à contact@reston.fr.";
            } else if (msg.includes('partenaires') || msg.includes('partenariat')) {
                response = "La liste de nos 'Partenaires' est visible sur notre carousel. Chaque restaurant utilisant Resto'N est un partenaire.";
            }
            addMessage(response, 'bot');
        }, 1000);
    }

    document.getElementById('chatbot-input').addEventListener('keypress', function (e) {
        if (e.key === 'Enter') {
            sendMessage();
        }
    });

    const tooltipTriggerList = document.querySelectorAll('[data-bs-toggle="tooltip"]')
    const tooltipList = [...tooltipTriggerList].map(tooltipTriggerEl => new bootstrap.Tooltip(tooltipTriggerEl))
</script>

{% block javascripts %}{% endblock %}
</body>
</html>
