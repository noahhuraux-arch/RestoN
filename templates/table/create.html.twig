{% extends 'base.html.twig' %}

{% block title %}Ajouter une table - {{ restaurant.libRestau }}{% endblock %}

{% block body %}
    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-md-6 col-lg-5">
                <nav aria-label="breadcrumb" class="mb-4">
                    <a href="{{ path('app_restaurant_tables', {restaurant: restaurant.id}) }}" class="text-decoration-none text-muted">
                        <i class="bi bi-arrow-left"></i> Retour au plan des tables
                    </a>
                </nav>

                <div class="card shadow-sm border-0 rounded-3">
                    <div class="card-header bg-white py-3 border-bottom-0">
                        <h2 class="h4 fw-bold mb-0 text-dark text-center">Nouvelle Table</h2>
                        <p class="text-muted small text-center mb-0">{{ restaurant.libRestau }}</p>
                    </div>

                    <div class="card-body p-4">
                        {{ form_start(form) }}

                        <div class="mb-3">
                            {{ form_label(form.numero, 'Numéro de la table', {label_attr: {class: 'form-label fw-bold small text-uppercase text-muted'}}) }}
                            {{ form_widget(form.numero, {attr: {class: 'form-control form-control-lg bg-light border-0', placeholder: 'Ex: 12'}}) }}
                            <div class="text-danger small mt-1">
                                {{ form_errors(form.numero) }}
                            </div>
                        </div>

                        <div class="mb-4">
                            {{ form_label(form.nbPlace, 'Nombre de couverts', {label_attr: {class: 'form-label fw-bold small text-uppercase text-muted'}}) }}
                            {{ form_widget(form.nbPlace, {attr: {class: 'form-control form-control-lg bg-light border-0', placeholder: 'Ex: 4'}}) }}
                            <div class="text-danger small mt-1">
                                {{ form_errors(form.nbPlace) }}
                            </div>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary btn-lg fw-bold shadow-sm py-3">
                                <i class="bi bi-check-circle me-2"></i>Enregistrer la table
                            </button>
                            <a href="{{ path('app_restaurant_tables', {restaurant: restaurant.id}) }}" class="btn btn-link text-muted text-decoration-none small">
                                Annuler
                            </a>
                        </div>

                        {{ form_end(form) }}
                    </div>
                </div>
                <div class="mt-4 p-3 bg-light rounded-3 border border-dashed text-center">
                    <small class="text-muted">
                        <i class="bi bi-info-circle me-1"></i>
                        La table sera automatiquement marquée comme <strong>Libre</strong> dès sa création.
                    </small>
                </div>

            </div>
        </div>
    </div>
{% endblock %}
