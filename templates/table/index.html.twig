{% extends 'base.html.twig' %}

{% block title %}Gestion des tables - {{ restaurant.libRestau }}{% endblock %}

{% block favicon %}
    {% if restaurant.logo %}
        <link rel="icon" href="{{ asset('images/logos/' ~ restaurant.logo) }}">
    {% else %}
        <link rel="icon" href="{{ asset('images/favicon.png') }}">
    {% endif %}
{% endblock %}

{% block body %}
    <div class="container mt-2">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h1 class="fw-bold h2 mb-0">Plan des Tables :</h1>
            </div>
        </div>

        <div class="row g-4 pb-4">
            {% for table in tables %}
                <div class="col-6 col-md-4 col-lg-3 col-xl-2">
                    {% set statut = table.bientotReserver %}
                    {% set reservation = table.getFirstReservation %}

                    <div class="card h-100 shadow-sm border-0 overflow-hidden">
                        {% if statut == 'Occupé' %}
                            {% if reservation %}
                                <a href="{{ path('app_reservation_show', {id: restaurant.id, idReservation: reservation.id}) }}" class="text-decoration-none">
                                    <div class="py-2 text-center bg-danger text-white">
                                        <small class="fw-bold text-uppercase">Occupé</small>
                                    </div>
                                </a>
                            {% else %}
                                <div class="py-2 text-center bg-danger text-white">
                                    <small class="fw-bold text-uppercase">Occupé</small>
                                </div>
                            {% endif %}

                        {% elseif statut == 'Reservee' %}
                            <a href="{{ path('app_reservation_show', {id: restaurant.id, idReservation: reservation.id}) }}" class="text-decoration-none">
                                <div class="py-2 text-center bg-warning text-dark">
                                    <small class="fw-bold text-uppercase">Réservé</small>
                                </div>
                            </a>
                        {% else %}
                            <div class="py-2 text-center bg-success text-white">
                                <small class="fw-bold text-uppercase">Libre</small>
                            </div>
                        {% endif %}

                        <div class="card-body text-center py-2">
                            <div class="fs-3 fw-bold mb-1">
                                <span>N°{{ table.numero }}</span>
                            </div>
                            <div class="text-muted small">
                                <span>{{ table.nbPlace}} places</span>
                            </div>
                            <a href="{{ path('app_commande_create', {id: restaurant.id, table: table.id}) }}"
                               class="btn btn-sm rounded-3 px-2 mt-1">
                                <i class="bi bi-plus-lg small"></i>
                                <span>Commande</span>
                            </a>
                        </div>
                    </div>
                </div>
            {% else %}
            {% endfor %}
        </div>
    </div>

{% endblock %}
