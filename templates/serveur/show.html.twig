{% extends 'base.html.twig' %}

{% block title %}Équipe - {{ restaurant.librestau }}{% endblock %}

{% block favicon %}<link rel="icon" href="{{ asset('images/logos/logo' ~ restaurant.id ~ '.png') }}">{% endblock %}

{% block navbar_brand %}
    <a class="navbar-brand" href="{{ path('app_restaurant_home', {id: restaurant.id}) }}">
        <img src="{{ asset('images/logos/logo' ~ restaurant.id ~ '.png') }}" alt="{{ restaurant.librestau }} Logo" width="40" height="40" class="d-inline-block align-middle me-2">
        {{ restaurant.librestau }}
    </a>
{% endblock %}

{% block body %}
    <div class="container py-5">
        <div class="row mb-5 align-items-center border-bottom pb-3">
            <div class="col-md-8">
                <h1 class="display-5 fw-bold">
                    <i class="fas fa-users text-warning me-3"></i>L'Équipe de Salle
                </h1>
                <p class="text-muted lead mb-0">Gestion du personnel pour {{ restaurant.librestau }}</p>
            </div>
            <div class="col-md-4 text-md-end mt-3 mt-md-0">
                <a href="{{ path('app_serveur_create', {id: restaurant.id}) }}" class="btn btn-primary me-2">
                    <i class="fas fa-plus me-2"></i>Ajouter un serveur
                </a>
                <a href="{{ path('app_restaurant_home', {id: restaurant.id}) }}" class="btn btn-outline-secondary">
                    <i class="fas fa-arrow-left me-2"></i>Retour au Restaurant
                </a>
            </div>
        </div>

        {% if serveurs|length > 0 %}
            <div class="row g-4">
                {% for serveur in serveurs %}
                    <div class="col-md-6 col-lg-4">
                        <div class="card h-100 shadow-sm border-0 hover-card">
                            <div class="card-body text-center p-4">
                                <h3 class="h4 card-title fw-bold text-dark mb-1">
                                    {{ serveur.prenom }} {{ serveur.nom|upper }}
                                </h3>

                                <hr class="w-25 mx-auto text-warning" style="opacity: 1;">

                                <div class="mt-3">
                                    <span class="badge bg-success-subtle text-success fs-6 px-3 py-2 border border-success-subtle">
                                        <i class="fas fa-coins me-2"></i>
                                        {{ serveur.salaire|number_format(2, ',', ' ') }} €
                                    </span>
                                </div>

                                <div class="mt-4 pt-3 border-top">
                                    <a href="{{ path('app_serveur_delete', {restaurant: restaurant.id, serveur: serveur.id}) }}"
                                       class="btn btn-outline-danger btn-sm w-100">
                                        <i class="fas fa-trash-alt me-2"></i>Supprimer
                                    </a>
                                </div>

                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% else %}
            <div class="alert alert-info d-flex align-items-center shadow-sm" role="alert">
                <i class="fas fa-info-circle fa-2x me-3"></i>
                <div>
                    <h4 class="alert-heading h5">Aucun serveur trouvé</h4>
                    <p class="mb-0">Il n'y a pas encore de personnel de salle rattaché à ce restaurant.</p>
                </div>
            </div>
        {% endif %}
    </div>
{% endblock %}
