{# templates/serveur/create.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Ajouter un serveur{% endblock %}

{% block body %}
    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-7">
                <h1 class="mb-4 text-center">Ajouter un serveur - {{ restaurant.libRestau }}</h1>

                <div class="card shadow-sm border-0">
                    <div class="card-body p-4">

                        <div class="alert alert-info small mb-4">
                            Le mot de passe par défaut sera : <strong>Bienvenue2026!</strong>
                        </div>

                        {{ form_start(form) }}

                        <div class="row">
                            <div class="col-md-6">
                                {{ form_row(form.prenom) }}
                            </div>
                            <div class="col-md-6">
                                {{ form_row(form.nom) }}
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                {{ form_row(form.email) }}
                            </div>
                            <div class="col-md-6">
                                {{ form_row(form.telephone) }}
                            </div>
                        </div>

                        {{ form_row(form.salaire) }}

                        {{ form_rest(form) }}

                        <div class="mt-4 d-grid gap-2 d-md-flex justify-content-md-end">
                            <a href="{{ path('app_serveur_show', {'id': restaurant.id}) }}" class="btn btn-secondary me-md-2">
                                Annuler
                            </a>

                            <button type="submit" class="btn btn-primary px-4">
                                Créer le serveur
                            </button>
                        </div>

                        {{ form_end(form) }}

                    </div>
                </div>

                <div class="text-center mt-3">
                    <a href="{{ path('app_serveur_show', {'id': restaurant.id}) }}" class="text-decoration-none text-muted small">
                        Retour à la liste
                    </a>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
