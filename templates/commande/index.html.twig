{% extends 'base.html.twig' %}

{% block title %}Historique des Commandes - {{ restaurant.libRestau }}{% endblock %}

{% block body %}
    <div class="container py-5">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1>Historique des Commandes</h1>
            <a href="{{ path('app_commande_create', {id: restaurant.id}) }}" class="btn btn-primary">
                + Nouvelle Commande
            </a>
        </div>

        <div class="card shadow-sm">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                    <tr>
                        <th>ID</th>
                        <th>Date</th>
                        <th>Serveur</th>
                        <th>Table</th>
                        <th>Produits</th>
                        <th class="text-end">Total</th>
                        <th class="text-center">Actions</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for commande in commandes %}
                        <tr>
                            <td>#{{ commande.id }}</td>
                            <td>{{ commande.dateCommande|date('d/m/Y H:i') }}</td>
                            <td>
                                {{ commande.serveur ? commande.serveur.nom : 'N/A' }}
                            </td>
                            <td>
                                {% if commande.tables %}
                                    Table n°{{ commande.tables.id }}
                                {% else %}
                                    <span class="text-muted small">Vente directe</span>
                                {% endif %}
                            </td>
                            <td>
                                <ul class="list-unstyled mb-0 small">
                                    {% for produit in commande %}
                                        <li>• {{ produit.libProduit }} ({{ produit.prixProduit|number_format(2, ',', ' ') }} €)</li>
                                    {% endfor %}
                                </ul>
                            </td>
                            <td class="text-end fw-bold text-primary">
                                {{ commande.prixCommande|number_format(2, ',', ' ') }} €
                            </td>
                            <td class="text-center">
                                <button class="btn btn-sm btn-outline-secondary">Détails</button>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">
                                Aucune commande enregistrée pour le moment.
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
{% endblock %}
