{% extends 'base.html.twig' %}

{% block title %}Historique des Commandes - {{ restaurant.libRestau }}{% endblock %}

{% block favicon %}
    {% if restaurant.logo %}
        <link rel="icon" href="{{ asset('images/logos/' ~ restaurant.logo) }}">
    {% else %}
        <link rel="icon" href="{{ asset('images/favicon.png') }}">
    {% endif %}
{% endblock %}

{% block body %}
    <div class="container py-5">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1>Historique des Commandes</h1>
            <a href="{{ path('app_restaurant_tables', {restaurant: restaurant.id}) }}" class="btn btn-primary">
                + Nouvelle Commande
            </a>
        </div>

        {# Vue Mobile (Cartes) #}
        <div class="d-md-none">
            {% for commande in commandes %}
                {% if not commande.isPaye %}
                    {% set serveur = commande.serveur ? commande.serveur.nom : restaurant.proprietaire.nom %}
                    <div class="card mb-3 shadow-sm border-0">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <div>
                                    <h5 class="fw-bold mb-1">Commande #{{ commande.id }}</h5>
                                    <small class="text-muted"><i class="bi bi-calendar3 me-1"></i>{{ commande.dateCommande|date('d/m/Y') }}</small>
                                </div>
                                <span class="badge bg-primary fs-6">{{ commande.prixCommande|number_format(2, ',', ' ') }} €</span>
                            </div>

                            <div class="mb-3">
                                <div class="d-flex align-items-center mb-1">
                                    <i class="bi bi-person-badge me-2 text-secondary"></i>
                                    <span>{{ serveur }}</span>
                                </div>
                                <div class="d-flex align-items-center">
                                    <i class="fas fa-chair me-2 text-secondary"></i>
                                    <span>Table n°{{ commande.tables.numero }}</span>
                                </div>
                            </div>

                            <div class="d-grid gap-2 d-flex">
                                <button class="btn btn-outline-dark flex-grow-1 js-details-btn" data-bs-toggle="modal" data-bs-target="#detailsModal" data-id="{{ commande.id }}" data-serveur="{{ serveur }}" data-table="{{ commande.tables ? 'Table n°' ~ commande.tables.numero }}" data-total="{{ commande.prixCommande|number_format(2, ',', ' ') }}" data-produits='[{% for p in commande.produits %}{"nom": "{{ p.libProduit }}", "prix": "{{ p.prixProduit|number_format(2, ',', ' ') }}"}{% if not loop.last %},{% endif %}{% endfor %}]'>
                                    <i class="bi bi-eye me-2"></i>Détails
                                </button>
                                <a href="{{ path('app_commande_payer', {id: restaurant.id, commande: commande.id}) }}" class="btn btn-success flex-grow-1">
                                    <i class="bi bi-credit-card me-2"></i>Payer
                                </a>
                            </div>
                        </div>
                    </div>
                {% endif %}
            {% endfor %}
        </div>

        {# Vue Desktop (Tableau) #}
        <div class="card shadow-sm d-none d-md-block">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                    <tr>
                        <th>Numéro</th>
                        <th>Date</th>
                        <th>Serveur</th>
                        <th>Table</th>
                        <th class="text-end">Total</th>
                        <th class="text-center">Actions</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for commande in commandes %}
                        {% if not commande.isPaye %}
                            {% set serveur = commande.serveur ? commande.serveur.nom : restaurant.proprietaire.nom %}
                            <tr class="border-bottom">
                                <td class="ps-4 text-muted">#{{ commande.id }}</td>
                                <td class="fw-medium">{{ commande.dateCommande|date('d/m/Y') }}</td>
                                <td>
                                    {% if commande.serveur is not null %}
                                        {{ serveur }}
                                    {% else %}
                                        {{ serveur }} <span class="badge bg-warning text-dark" style="font-size: 0.8rem;">Proprio</span>
                                    {% endif %}
                                </td>
                                <td>Table n°{{ commande.tables.numero }}</td>
                                <td class="text-end fw-bold text-primary">
                                    {{ commande.prixCommande|number_format(2, ',', ' ') }} €
                                </td>
                                <td class="text-center pe-4">
                                    <div class="btn-group">
                                        <button class="btn btn-sm btn-outline-dark px-3 js-details-btn"
                                                data-bs-toggle="modal"
                                                data-bs-target="#detailsModal"
                                                data-id="{{ commande.id }}"
                                                data-serveur="{{ serveur }}"
                                                data-table="{{ commande.tables ? 'Table n°' ~ commande.tables.numero }}"
                                                data-total="{{ commande.prixCommande|number_format(2, ',', ' ') }}"
                                                data-produits='[{% for p in commande.produits %}{"nom": "{{ p.libProduit }}", "prix": "{{ p.prixProduit|number_format(2, ',', ' ') }}"}{% if not loop.last %},{% endif %}{% endfor %}]'>
                                            <i class="bi bi-eye me-1"></i> Détails
                                        </button>
                                        <a href="{{ path('app_commande_payer', {id: restaurant.id, commande: commande.id}) }}"
                                           class="btn btn-sm btn-success">
                                            <i class="bi bi-credit-card me-1"></i> Payer
                                        </a>
                                    </div>
                            </td>
                        </tr>
                        {% endif %}
                    {% else %}
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">
                                Aucune commande enregistrée pour le moment.
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="modal fade" id="detailsModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg" style="border-radius: 15px;">
                <div class="modal-header text-white px-4 py-3" style="background-color: #1a2a3a; border-radius: 15px 15px 0 0;">
                    <h5 class="modal-title fw-bold">Détails de la Commande #<span id="modal-id"></span></h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="d-flex justify-content-between mb-4">
                        <div>
                            <span class="d-block text-muted small text-uppercase fw-bold">Serveur</span>
                            <div id="modal-serveur" class="h6"></div>
                        </div>
                        <div class="text-end">
                            <span class="d-block text-muted small text-uppercase fw-bold">Emplacement</span>
                            <div id="modal-table" class="h6"></div>
                        </div>
                    </div>

                    <div class="mb-4">
                        <span class="d-block text-muted small text-uppercase fw-bold mb-2">Produits</span>
                        <div class="rounded-3 p-3" style="background-color: #f8f9fa;">
                            <ul id="modal-produits-list" class="list-group list-group-flush bg-transparent">
                            </ul>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                        <span class="h6 mb-0 text-muted">Total réglé</span>
                        <span class="h4 mb-0 fw-bold" style="color: #1a2a3a;"><span id="modal-total"></span> €</span>
                    </div>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-light w-100 text-muted py-2" data-bs-dismiss="modal" style="border-radius: 8px;">Fermer</button>
                </div>
            </div>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const detailButtons = document.querySelectorAll('.js-details-btn');

            detailButtons.forEach(button => {
                button.addEventListener('click', function() {
                    const id = this.dataset.id;
                    const serveur = this.dataset.serveur;
                    const table = this.dataset.table;
                    const total = this.dataset.total;
                    const produits = JSON.parse(this.dataset.produits);

                    document.getElementById('modal-id').innerText = id;
                    document.getElementById('modal-serveur').innerText = serveur;
                    document.getElementById('modal-table').innerText = table;
                    document.getElementById('modal-total').innerText = total;

                    const listContainer = document.getElementById('modal-produits-list');
                    listContainer.innerHTML = '';

                    produits.forEach(p => {
                        const li = document.createElement('li');
                        li.className = 'list-group-item d-flex justify-content-between align-items-center px-0 border-0 bg-transparent py-1 small';
                        li.innerHTML = `
                                <span class="text-dark">${p.nom}</span>
                                <span class="fw-medium">${p.prix} €</span>
                            `;
                        listContainer.appendChild(li);
                    });
                });
            });
        });
    </script>
{% endblock %}
