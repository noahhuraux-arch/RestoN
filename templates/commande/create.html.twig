{% extends 'base.html.twig' %}

{% block title %}Création commande - {{ restaurant.libRestau }}{% endblock %}

{% block favicon %}
    {% if restaurant.logo %}
        <link rel="icon" href="{{ asset('images/logos/' ~ restaurant.logo) }}">
    {% else %}
        <link rel="icon" href="{{ asset('images/favicon.png') }}">
    {% endif %}
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .product-card.active {
            background-color: #198754 !important;
            border-color: #198754 !important;
            color: white !important;
        }
        .product-card.active .text-dark,
        .product-card.active .text-success,
        .product-card.active .text-muted {
            color: white !important;
        }
    </style>
{% endblock %}

{% block body %}
    <div class="container-fluid py-4 bg-light">
        {{ form_start(form, {attr: {autocomplete: 'off'}}) }}
        <div class="row">
            <div class="col-lg-8">
                <div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
                    <h1 class="h3 fw-bold mb-0 text-dark">Carte</h1>

                    <div class="d-flex align-items-center gap-3">
                        <div class="form-check form-switch bg-white p-2 px-3 rounded shadow-sm border">
                            <input class="form-check-input ms-0 me-2" type="checkbox" id="vege-filtre">
                            <label class="form-check-label fw-bold text-success small" for="vege-filtre">
                                <i class="fas fa-leaf me-1"></i>Végétarien
                            </label>
                        </div>

                        <div class="dropdown shadow-sm">
                            <button class="btn btn-white border dropdown-toggle fw-bold small" type="button" id="dropAllergenes" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="fas fa-exclamation-triangle text-warning me-2"></i>Exclure des allergènes
                            </button>
                            <ul class="dropdown-menu shadow border-0" aria-labelledby="dropAllergenes">
                                {% set liste_complete_allergenes = [] %}
                                {% for cat, prods in produitsGroupes %}
                                    {% for p in prods %}
                                        {% for a in p.allergenes %}
                                            {% if a.id not in liste_complete_allergenes|map(i => i.id) %}
                                                {% set liste_complete_allergenes = liste_complete_allergenes|merge([a]) %}
                                            {% endif %}
                                        {% endfor %}
                                    {% endfor %}
                                {% endfor %}

                                {% for a in liste_complete_allergenes %}
                                    <li class="allergen-item">
                                        <div class="form-check">
                                            <input class="form-check-input js-allergen-checkbox" type="checkbox" value="{{ a.id }}" id="allergen-{{ a.id }}">
                                            <label class="form-check-label small" for="allergen-{{ a.id }}">{{ a.name }}</label>
                                        </div>
                                    </li>
                                {% else %}
                                    <li class="p-2 small text-muted text-center">Aucun allergène trouvé</li>
                                {% endfor %}
                            </ul>
                        </div>
                    </div>
                </div>

                {% for categorie, produits in produitsGroupes %}
                    <div class="mb-3 category-section">
                        <button type="button" class="btn btn-white w-100 text-start d-flex justify-content-between align-items-center p-3 shadow-sm border-0 rounded-3"
                                data-bs-toggle="collapse" data-bs-target="#collapse-{{ loop.index }}">
                            <h5 class="mb-0 fw-bold text-uppercase text-warning">{{ categorie }}</h5>
                            <i class="fas fa-chevron-down text-muted"></i>
                        </button>

                        <div class="collapse show mt-3" id="collapse-{{ loop.index }}">
                            <div class="row g-3">
                                {% for index, p in produits %}
                                    {% set child = form.produits[index] %}
                                    {% set qteInitiale = 1 %}
                                    {% for cq in form.vars.value.commandeQuantites %}
                                        {% if cq.produit.id == p.id %}
                                            {% set qteInitiale = cq.quantite %}
                                        {% endif %}
                                    {% endfor %}

                                    <div class="col-md-6 col-xl-4 js-filterable-item"
                                         data-vege="{{ (p.vegetarien is defined and p.vegetarien) ? '1' : '0' }}"
                                         data-allergenes="{{ p.allergenes|map(a => a.id)|join(',') }}">

                                        <div class="card h-100 border-2 product-card js-product-card shadow-sm {{ child.vars.checked ? 'active' : '' }}"
                                             data-price="{{ p.prixProduit|number_format(2, '.', '') }}" style="cursor: pointer; border-radius: 10px;">

                                            <div class="card-body p-3">
                                                <div class="d-flex align-items-center mb-2">
                                                    <div class="d-none">{{ form_widget(child, {attr: {class: 'js-check'}}) }}</div>
                                                    <div class="flex-grow-1">
                                                        <span class="d-block fw-bold text-dark">{{ p.libProduit }}</span>
                                                        <span class="text-success small fw-bold">{{ p.prixProduit|number_format(2, ',', ' ') }} €</span>
                                                    </div>
                                                    <div class="js-icon-check text-success {{ child.vars.checked ? '' : 'd-none' }}">
                                                        <i class="fas fa-check-circle h4 mb-0"></i>
                                                    </div>
                                                </div>
                                                <div class="js-qty-container {{ child.vars.checked ? '' : 'd-none' }} border-top pt-2">
                                                    <div class="input-group input-group-sm mb-2">
                                                        <span class="input-group-text bg-light border-0 small">Qté</span>
                                                        <input type="number" name="qtys[{{ p.id }}]"
                                                               class="form-control border-0 bg-light text-center js-qty-input"
                                                               value="{{ qteInitiale > 0 ? qteInitiale : 1 }}" min="1"
                                                               onclick="event.stopPropagation();">
                                                    </div>

                                                    {% if categorie == 'Menus' %}
                                                        <div class="composition-selector p-2 bg-light rounded shadow-sm">
                                                            <div class="mb-2">
                                                                <label class="x-small fw-bold text-muted">ENTRÉE</label>
                                                                <select name="comp[{{ p.id }}][e]" class="form-select form-select-sm" onclick="event.stopPropagation();">
                                                                    <option value="">-- Choisir --</option>
                                                                    {% for item in produitsGroupes['Entrées']|default([]) %}<option value="{{ item.id }}">{{ item.libProduit }}</option>{% endfor %}
                                                                </select>
                                                            </div>
                                                            <div class="mb-2">
                                                                <label class="x-small fw-bold text-muted">PLAT</label>
                                                                <select name="comp[{{ p.id }}][p]" class="form-select form-select-sm" onclick="event.stopPropagation();">
                                                                    <option value="">-- Choisir --</option>
                                                                    {% for item in produitsGroupes['Plats']|default([]) %}<option value="{{ item.id }}">{{ item.libProduit }}</option>{% endfor %}
                                                                </select>
                                                            </div>
                                                            <div>
                                                                <label class="x-small fw-bold text-muted">DESSERT</label>
                                                                <select name="comp[{{ p.id }}][d]" class="form-select form-select-sm" onclick="event.stopPropagation();">
                                                                    <option value="">-- Choisir --</option>
                                                                    {% for item in produitsGroupes['Desserts']|default([]) %}<option value="{{ item.id }}">{{ item.libProduit }}</option>{% endfor %}
                                                                </select>
                                                            </div>
                                                        </div>
                                                    {% endif %}
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                {% endfor %}
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>

            <div class="col-lg-4">
                <div class="card shadow border-0" style="position: sticky; top: 90px; z-index: 900; border-radius: 12px; overflow: hidden;">
                    <div class="card-header bg-dark text-white py-3 text-center">
                        <h5 class="mb-0 fw-bold">TOTAL : <span id="total-display">0,00</span> €</h5>
                    </div>
                    <div class="card-body p-4 text-center">
                        <div class="mb-3 fw-medium">Serveur : {{ serveur.nom }}</div>
                        <div class="mb-4 fw-medium">Table N°{{ table.numero }}</div>
                        <div class="mb-4 fw-medium">
                            <div class="mb-2 text-muted small text-uppercase fw-bold">Résumé de la commande :</div>
                            <div id="order-summary-list" class="text-start border-top pt-2">
                                <p class="text-muted small">Aucun produit sélectionné</p>
                            </div>
                        </div>
                        <button type="submit" class="btn btn-success btn-lg w-100 py-3 fw-bold shadow-sm">VALIDER LA COMMANDE</button>
                    </div>
                </div>
            </div>
        </div>
        {% do form.produits.setRendered() %}
        {{ form_end(form) }}
    </div>

    <style>
        .product-card.active { border-color: #198754 !important; background-color: #f8fffb; }
        .x-small { font-size: 0.7rem; }
    </style>

    <script>
        const produitsSelectionnesIds = {{ produitsSelectionnesIds|default([])|json_encode|raw }};

        document.addEventListener('DOMContentLoaded', function() {
            const cards = document.querySelectorAll('.js-product-card');
            const totalDisplay = document.getElementById('total-display');
            const summaryList = document.getElementById('order-summary-list');
            const vegeFiltre = document.getElementById('vege-filtre');
            const allergen = document.querySelectorAll('.js-allergen-checkbox');
            const filtre = document.querySelectorAll('.js-filterable-item');

            function updateTotal() {
                let totalValue = 0;
                let summaryHtml = '';

                document.querySelectorAll('.js-check:checked').forEach(check => {
                    const card = check.closest('.js-product-card');
                    const price = parseFloat(card.dataset.price);
                    const qtyInput = card.querySelector('.js-qty-input');
                    const qty = parseInt(qtyInput.value) || 1;
                    const productName = card.querySelector('.fw-bold.text-dark').innerText;

                    totalValue += (price * qty);

                    summaryHtml += `
                    <div class="d-flex justify-content-between align-items-center mb-1 small">
                        <span>${productName} x ${qty}</span>
                        <span class="fw-bold">${(price * qty).toFixed(2).replace('.', ',')} €</span>
                    </div>`;
                });

                if (totalDisplay) {
                    totalDisplay.innerText = totalValue.toLocaleString('fr-FR', { minimumFractionDigits: 2 });
                }

                if (summaryList) {
                    summaryList.innerHTML = summaryHtml === ''
                        ? '<p class="text-muted small italic">Aucun produit sélectionné</p>'
                        : summaryHtml;
                }
            }

            function runFilters() {
                if (!vegeFiltre) return;
                const isVege = vegeFiltre.checked;
                const idExclu = Array.from(allergen).filter(cb => cb.checked).map(cb => cb.value);

                filtre.forEach(item => {
                    const vege = item.dataset.vege === '1';
                    const allergenesAttr = item.dataset.allergenes || "";
                    const allergenes = allergenesAttr.split(',').filter(id => id !== "");

                    const respecteVeges = !isVege || vege;
                    const aUnAllergene = idExclu.some(id => allergenes.includes(id));

                    if (respecteVeges && !aUnAllergene) {
                        item.classList.remove('d-none');
                    } else {
                        item.classList.add('d-none');
                    }
                });
            }

            cards.forEach(card => {
                const checkbox = card.querySelector('.js-check');
                const qtyInput = card.querySelector('.js-qty-input');
                const qtyContainer = card.querySelector('.js-qty-container');
                const iconCheck = card.querySelector('.js-icon-check');

                const match = qtyInput ? qtyInput.name.match(/\d+/) : null;
                const produitId = match ? parseInt(match[0]) : null;

                if (produitId && produitsSelectionnesIds.includes(produitId)) {
                    checkbox.checked = true;
                    card.classList.add('active');
                    if (qtyContainer) qtyContainer.classList.remove('d-none');
                    if (iconCheck) iconCheck.classList.remove('d-none');
                }
            });

            cards.forEach(card => {
                const qtyInput = card.querySelector('.js-qty-input');
                const qtyContainer = card.querySelector('.js-qty-container');
                const iconCheck = card.querySelector('.js-icon-check');

                card.addEventListener('click', function(e) {
                    if (e.target.tagName === 'INPUT' || e.target.tagName === 'SELECT') return;

                    const checkbox = this.querySelector('.js-check');
                    checkbox.checked = !checkbox.checked;

                    this.classList.toggle('active', checkbox.checked);
                    if (qtyContainer) qtyContainer.classList.toggle('d-none', !checkbox.checked);
                    if (iconCheck) iconCheck.classList.toggle('d-none', !checkbox.checked);

                    updateTotal();
                });

                if (qtyInput) {
                    qtyInput.addEventListener('input', function(e) {
                        e.stopPropagation();
                        updateTotal();
                    });
                }
            });

            if (vegeFiltre) {
                vegeFiltre.addEventListener('change', runFilters);
            }
            allergen.forEach(cb => cb.addEventListener('change', runFilters));

            document.querySelectorAll('.dropdown-menu').forEach(menu => {
                menu.addEventListener('click', (e) => e.stopPropagation());
            });

            updateTotal();
            runFilters();
        });
    </script>
{% endblock %}
