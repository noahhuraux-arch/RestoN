{% extends 'base.html.twig' %}

{% block title %}Création commande - {{ restaurant.libRestau }}{% endblock %}

{% block favicon %}
    {% if restaurant.logo %}
        <link rel="icon" href="{{ asset('images/logos/' ~ restaurant.logo) }}">
    {% else %}
        <link rel="icon" href="{{ asset('images/favicon.png') }}">
    {% endif %}
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .product-card.active {
            background-color: #198754 !important;
            border-color: #198754 !important;
            color: white !important;
        }
        .product-card.active .text-dark,
        .product-card.active .text-success,
        .product-card.active .text-muted {
            color: white !important;
        }
    </style>
{% endblock %}

{% block body %}
    <div class="container-fluid py-4 bg-light">
        {{ form_start(form, {'attr': {'autocomplete': 'off'}}) }}
        <div class="row">
            <div class="col-lg-8">
                <h1 class="h3 fw-bold mb-4 text-dark">Carte</h1>

                {% for categorie, produits in produitsGroupes %}
                    <div class="mb-3">
                        <button type="button" 
                                class="btn btn-white w-100 text-start d-flex justify-content-between align-items-center p-3 shadow-sm border-0 rounded-3" 
                                data-bs-toggle="collapse" 
                                data-bs-target="#collapse-{{ loop.index }}" 
                                aria-expanded="true">
                            <h5 class="mb-0 fw-bold text-uppercase text-warning">{{ categorie }}</h5>
                            <i class="fas fa-chevron-down text-muted"></i>
                        </button>

                        <div class="collapse show mt-3" id="collapse-{{ loop.index }}">
                            <div class="row g-3">
                                {% for index, p in produits %}
                                    {% set child = form.produits[index] %}
                                    {% set qteInitiale = 0 %}
                                    {% for prodId in form.vars.value.produits %}
                                        {% if prodId.id == p.id %}{% set qteInitiale = qteInitiale + 1 %}{% endif %}
                                    {% endfor %}

                                    <div class="col-md-6 col-xl-4">
                                        <div class="card h-100 border-2 product-card js-product-card shadow-sm {{ child.vars.checked ? 'active' : '' }}"
                                             data-price="{{ p.prixProduit|number_format(2, '.', '') }}"
                                             style="cursor: pointer; border-radius: 10px;">
                                            <div class="card-body p-3">
                                                <div class="d-flex align-items-center mb-2">
                                                    <div class="d-none">
                                                        {{ form_widget(child, {attr: {class: 'js-check'}}) }}
                                                    </div>
                                                    <div class="flex-grow-1">
                                                        <span class="d-block fw-bold text-dark">{{ p.libProduit }}</span>
                                                        <span class="text-success small fw-bold">{{ p.prixProduit|number_format(2, ',', ' ') }} €</span>
                                                    </div>
                                                    <div class="js-icon-check text-success d-none">
                                                        <i class="fas fa-check-circle h4 mb-0"></i>
                                                    </div>
                                                </div>
                                                <div class="js-qty-container {{ child.vars.checked ? '' : 'd-none' }} border-top pt-2">
                                                    <div class="input-group input-group-sm mb-2">
                                                        <span class="input-group-text bg-light border-0 small">Qté</span>
                                                        <input type="number" name="qtys[{{ p.id }}]"
                                                               class="form-control border-0 bg-light text-center js-qty-input"
                                                               value="{{ qteInitiale > 0 ? qteInitiale : 1 }}" min="1"
                                                               onclick="event.stopPropagation();">
                                                    </div>

                                                    {% if categorie == 'Menus' %}
                                                        <div class="composition-selector p-2 bg-light rounded shadow-sm">
                                                            <div class="mb-2">
                                                                <label class="x-small fw-bold text-muted">ENTRÉE</label>
                                                                <select name="comp[{{ p.id }}][e]" class="form-select form-select-sm" onclick="event.stopPropagation();">
                                                                    <option value="">-- Choisir --</option>
                                                                    {% for item in produitsGroupes['Entrées']|default([]) %}<option value="{{ item.id }}">{{ item.libProduit }}</option>{% endfor %}
                                                                </select>
                                                            </div>
                                                            <div class="mb-2">
                                                                <label class="x-small fw-bold text-muted">PLAT</label>
                                                                <select name="comp[{{ p.id }}][p]" class="form-select form-select-sm" onclick="event.stopPropagation();">
                                                                    <option value="">-- Choisir --</option>
                                                                    {% for item in produitsGroupes['Plats']|default([]) %}<option value="{{ item.id }}">{{ item.libProduit }}</option>{% endfor %}
                                                                </select>
                                                            </div>
                                                            <div>
                                                                <label class="x-small fw-bold text-muted">DESSERT</label>
                                                                <select name="comp[{{ p.id }}][d]" class="form-select form-select-sm" onclick="event.stopPropagation();">
                                                                    <option value="">-- Choisir --</option>
                                                                    {% for item in produitsGroupes['Desserts']|default([]) %}<option value="{{ item.id }}">{{ item.libProduit }}</option>{% endfor %}
                                                                </select>
                                                            </div>
                                                        </div>
                                                    {% endif %}
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                {% endfor %}
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>

            <div class="col-lg-4">
                <div class="card shadow border-0" style="position: sticky; top: 90px; z-index: 900; border-radius: 12px; overflow: hidden;">
                    <div class="card-header bg-dark text-white py-3 text-center">
                        <h5 class="mb-0 fw-bold">TOTAL : <span id="total-display">0,00</span> €</h5>
                    </div>
                    <div class="card-body p-4 text-center">
                        <div class="mb-3 fw-medium">Serveur : {{ serveur.nom }}</div>
                        <div class="mb-4 fw-medium">Table N°{{ table.numero }}</div>
                        <button type="submit" class="btn btn-success btn-lg w-100 py-3 fw-bold shadow-sm">VALIDER LA COMMANDE</button>
                    </div>
                </div>
            </div>
        </div>
        {% do form.produits.setRendered() %}
        {{ form_end(form) }}
    </div>

    <style>
        .product-card.active { border-color: #198754 !important; background-color: #f8fffb; }
        .x-small { font-size: 0.7rem; }
    </style>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const cards = document.querySelectorAll('.js-product-card');
            const totalDisplay = document.getElementById('total-display');

            function updateTotal() {
                let total = 0;
                document.querySelectorAll('.js-check:checked').forEach(check => {
                    const card = check.closest('.js-product-card');
                    const price = parseFloat(card.dataset.price);
                    const qty = parseInt(card.querySelector('.js-qty-input').value) || 1;
                    total += (price * qty);
                });
                totalDisplay.innerText = total.toLocaleString('fr-FR', { minimumFractionDigits: 2 });
            }

            updateTotal();

            cards.forEach(card => {
                const qtyInput = card.querySelector('.js-qty-input');
                const qtyContainer = card.querySelector('.js-qty-container');

                card.addEventListener('click', function() {
                    const checkbox = this.querySelector('.js-check');

                    checkbox.checked = !checkbox.checked;
                    this.classList.toggle('active', checkbox.checked);
                    qtyContainer.classList.toggle('d-none', !checkbox.checked);

                    updateTotal();
                });
                qtyInput.addEventListener('input', updateTotal);
            });
        });
    </script>
{% endblock %}
